<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Attendance</h4>
    <span class="text-muted">Today: <%= today %></span>
</div>

<%
function formatDate(d) {
    if (!d) return '';
    var parts = d.split('-');
    if (parts.length === 3) return parts[2] + '-' + parts[1] + '-' + parts[0];
    return d;
}
function formatMembership(t) {
    if (t === '1_month') return '1 Month';
    if (t === '3_months') return '3 Months';
    if (t === '6_months') return '6 Months';
    if (t === '1_year') return '1 Year';
    return t || '';
}
%>

<!-- Check-in Box -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" id="checkinInput" placeholder="Enter Member ID or search name..." autocomplete="off" list="memberList">
                    <button class="btn btn-dark" id="checkinBtn"><i class="fas fa-check me-1"></i>Check In</button>
                </div>
                <datalist id="memberList">
                    <% members.forEach(function(m) { %>
                    <option value="<%= m.id %>"><%= m.full_name %> (#<%= m.id %>)</option>
                    <% }); %>
                </datalist>
            </div>
            <div class="col-md-7">
                <div id="checkinResult" style="display:none;" class="alert py-2 mb-0 small"></div>
            </div>
        </div>
    </div>
</div>

<!-- Members Table -->
<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-sm mb-0" style="font-size: 0.85rem;" id="attendanceTable">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Class</th>
                    <th>Type</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Coach</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% members.forEach(function(m) { %>
                <tr id="member-row-<%= m.id %>" data-member-id="<%= m.id %>" data-member-name="<%= m.full_name.toLowerCase() %>" data-end="<%= m.membership_end || '' %>" data-classtype="<%= m.class_type || 'crossfit' %>" data-status="<%= m.status %>">
                    <td><%= m.id %></td>
                    <td><strong><%= m.full_name %></strong></td>
                    <td class="text-nowrap"><%= m.phone %></td>
                    <td><span class="badge-pill badge-<%= m.class_type || 'crossfit' %>"><%= m.class_type || 'crossfit' %></span></td>
                    <td><span class="badge-pill badge-<%= m.membership_type || '' %>"><%= formatMembership(m.membership_type) %></span></td>
                    <td class="text-nowrap"><%= formatDate(m.membership_start) %></td>
                    <td class="text-nowrap"><%= formatDate(m.membership_end) %></td>
                    <td><% if (m.coach_name) { %><span class="badge-pill badge-coach"><i class="fas fa-user me-1"></i><%= m.coach_name %></span><% } else { %>—<% } %></td>
                    <td><span class="badge-pill badge-<%= m.status %>"><%= m.status %></span></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% if (members.length === 0) { %><p class="text-muted text-center py-3 mb-0">No members found.</p><% } %>
    </div>
</div>

<style>
    .row-valid { background-color: #d1e7dd !important; border-left: 4px solid #198754; }
    .row-expiring { background-color: #fff3cd !important; border-left: 4px solid #fd7e14; }
    .row-expired { background-color: #f8d7da !important; border-left: 4px solid #dc3545; }
    .badge-pill { border-radius: 12px; padding: 3px 10px; font-size: 0.75rem; font-weight: 500; }
    .badge-crossfit { background-color: #00462e; color: #fff; }
    .badge-boxing { background-color: #2c3e50; color: #fff; }
    .badge-kick_boxing { background-color: #8e44ad; color: #fff; }
    .badge-1_month { background-color: #3498db; color: #fff; }
    .badge-3_months { background-color: #27ae60; color: #fff; }
    .badge-6_months { background-color: #f39c12; color: #fff; }
    .badge-1_year { background-color: #e74c3c; color: #fff; }
    .badge-coach { background-color: #e91e63; color: #fff; border-radius: 12px; padding: 3px 8px; font-size: 0.75rem; }
    .badge-active { background-color: #4caf50; color: #fff; }
    .badge-inactive { background-color: #9e9e9e; color: #fff; }
    .badge-frozen { background-color: #00bcd4; color: #fff; }
    .badge-expired { background-color: #f44336; color: #fff; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('checkinInput');
    var btn = document.getElementById('checkinBtn');
    var result = document.getElementById('checkinResult');

    btn.addEventListener('click', doCheckin);
    input.addEventListener('keydown', function(e) { if (e.key === 'Enter') doCheckin(); });

    function doCheckin() {
        var val = input.value.trim();
        if (!val) return;

        var memberId = val.match(/\d+/);
        if (!memberId) { showResult('danger', 'Please enter a valid member ID'); return; }
        memberId = memberId[0];

        // Highlight the row
        document.querySelectorAll('#attendanceTable tbody tr').forEach(function(row) {
            row.classList.remove('row-valid', 'row-expiring', 'row-expired');
        });

        fetch('/attendance/checkin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ member_id: memberId })
        }).then(function(r) { return r.json(); }).then(function(d) {
            var row = document.getElementById('member-row-' + memberId);
            if (d.success) {
                var msg = '<i class="fas fa-check-circle me-2"></i><strong>' + d.member_name + '</strong> checked in at ' + d.check_in_time;
                if (d.pt_deducted) msg += ' <span class="badge bg-info ms-2">PT session deducted</span>';
                if (d.warning) msg += '<br><small class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>' + d.warning + '</small>';
                showResult('success', msg);
                if (row) { row.classList.add('row-valid'); row.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
            } else {
                var color = d.status === 'expired' ? 'danger' : d.status === 'duplicate' ? 'warning' : 'secondary';
                showResult(color, '<i class="fas fa-times-circle me-2"></i>' + d.error);
                if (row) {
                    row.classList.add(d.status === 'expired' ? 'row-expired' : d.status === 'duplicate' ? 'row-expiring' : 'row-expired');
                    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
            input.value = '';
            input.focus();
        });
    }

    function showResult(type, msg) {
        result.className = 'alert alert-' + type + ' py-2 mb-0 small';
        result.innerHTML = msg;
        result.style.display = 'block';
        setTimeout(function() { result.style.display = 'none'; }, 5000);
    }
});
</script>
