<h4 class="mb-4"><i class="fas fa-chart-line me-2"></i>Dashboard</h4>

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card stat-card p-3" style="border-color: #27ae60;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Active Members</small>
                    <h3 class="mb-0"><%= stats.activeMembers %></h3>
                </div>
                <i class="fas fa-users fa-2x text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card stat-card p-3" style="border-color: #3498db;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Today's Check-ins</small>
                    <h3 class="mb-0"><%= stats.todayCheckins %></h3>
                </div>
                <i class="fas fa-clipboard-check fa-2x text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card stat-card p-3" style="border-color: #e74c3c;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Expiring Soon</small>
                    <h3 class="mb-0"><%= stats.expiringMemberships %></h3>
                </div>
                <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card stat-card p-3" style="border-color: #f39c12;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Monthly Revenue</small>
                    <h3 class="mb-0"><%= stats.monthlyRevenue %> EGP</h3>
                </div>
                <i class="fas fa-money-bill fa-2x text-warning"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-7 mb-4">
        <div class="card p-4">
            <h6><i class="fas fa-chart-bar me-2"></i>Weekly Attendance</h6>
            <canvas id="attendanceChart" height="150"></canvas>
        </div>
    </div>
    <div class="col-md-5 mb-4">
        <div class="card p-4">
            <h6 class="text-danger"><i class="fas fa-clock me-2"></i>Expiring Memberships</h6>
            <% if (stats.expiringList.length === 0) { %>
                <p class="text-muted">No expiring memberships this week.</p>
            <% } else { %>
                <div class="list-group list-group-flush">
                    <% stats.expiringList.forEach(m => { %>
                    <div class="list-group-item d-flex justify-content-between px-0">
                        <span><%= m.full_name %></span>
                        <small class="text-danger"><%= m.membership_end %></small>
                    </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const ctx = document.getElementById('attendanceChart').getContext('2d');
new Chart(ctx, {
    type: 'bar',
    data: {
        labels: [<%= stats.weeklyAttendance.map(d => `'${d.date}'`).join(',') %>],
        datasets: [{
            label: 'Check-ins',
            data: [<%= stats.weeklyAttendance.map(d => d.count).join(',') %>],
            backgroundColor: '#e74c3c'
        }]
    },
    options: { scales: { y: { beginAtZero: true } }, plugins: { legend: { display: false } } }
});
</script>
