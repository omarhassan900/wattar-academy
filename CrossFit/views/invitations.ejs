<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-ticket-alt me-2"></i>Invitations & Orientations</h4>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addInvitationModal">
        <i class="fas fa-user-plus me-1"></i>Add Invitation
    </button>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <% if (filters.error === 'duplicate') { %>
        <div class="alert alert-danger py-2 mb-2 small">
            <i class="fas fa-exclamation-triangle me-1"></i>
            Phone <strong><%= filters.phone %></strong> already exists! This invitation belongs to <strong><%= filters.owner %></strong>.
        </div>
        <% } %>
        <form method="GET" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" class="form-control form-control-sm" name="search" placeholder="Search name or phone..." value="<%= filters.search || '' %>">
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-sm" name="status">
                    <option value="">All Statuses</option>
                    <option value="new" <%= filters.status === 'new' ? 'selected' : '' %>>New</option>
                    <option value="contacted" <%= filters.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
                    <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                    <option value="attended" <%= filters.status === 'attended' ? 'selected' : '' %>>Attended</option>
                    <option value="no_show" <%= filters.status === 'no_show' ? 'selected' : '' %>>No Show</option>
                    <option value="converted" <%= filters.status === 'converted' ? 'selected' : '' %>>Converted</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark btn-sm w-100">Filter</button>
            </div>
            <div class="col-md-3 text-end">
                <span class="text-muted small"><%= invitations.length %> invitation<%= invitations.length !== 1 ? 's' : '' %></span>
            </div>
        </form>
    </div>
</div>

<!-- Invitations Table -->
<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-sm mb-0" style="font-size: 0.85rem;">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Source</th>
                    <th>Sales</th>
                    <th>Status</th>
                    <th>Scheduled</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <% invitations.forEach(i => { %>
                <tr>
                    <td><%= i.id %></td>
                    <td><strong><%= i.full_name %></strong></td>
                    <td class="text-nowrap"><%= i.phone %></td>
                    <td><%= i.email || '-' %></td>
                    <td><%= i.gender %></td>
                    <td><%= i.source || '-' %></td>
                    <td><%= i.sales_name || '-' %></td>
                    <td>
                        <% if (i.status === 'new') { %>
                            <span class="badge bg-primary">New</span>
                        <% } else if (i.status === 'contacted') { %>
                            <span class="badge bg-info">Contacted</span>
                        <% } else if (i.status === 'confirmed') { %>
                            <span class="badge bg-warning text-dark">Confirmed</span>
                        <% } else if (i.status === 'attended') { %>
                            <span class="badge bg-success">Attended</span>
                        <% } else if (i.status === 'no_show') { %>
                            <span class="badge bg-secondary">No Show</span>
                        <% } else if (i.status === 'converted') { %>
                            <span class="badge bg-dark">Converted</span>
                        <% } %>
                    </td>
                    <td class="text-nowrap"><%= i.scheduled_date || '-' %></td>
                    <td class="text-nowrap"><%= i.created_at ? new Date(i.created_at).toLocaleDateString() : '-' %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% if (invitations.length === 0) { %><p class="text-muted text-center py-3 mb-0">No invitations found.</p><% } %>
    </div>
</div>

<!-- Add Invitation Modal -->
<div class="modal fade" id="addInvitationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/invitations">
                <div class="modal-header"><h5 class="modal-title">Add New Invitation</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 mb-2"><label class="form-label">Full Name *</label><input type="text" class="form-control form-control-sm" name="full_name" required></div>
                        <div class="col-6 mb-2"><label class="form-label">Phone *</label><input type="tel" class="form-control form-control-sm" name="phone" required></div>
                        <div class="col-6 mb-2"><label class="form-label">Email</label><input type="email" class="form-control form-control-sm" name="email"></div>
                        <div class="col-6 mb-2"><label class="form-label">Gender</label><select class="form-select form-select-sm" name="gender"><option value="male">Male</option><option value="female">Female</option></select></div>
                        <div class="col-6 mb-2"><label class="form-label">Source</label><input type="text" class="form-control form-control-sm" name="source" placeholder="e.g. Instagram, Walk-in, Referral"></div>
                        <div class="col-6 mb-2">
                            <label class="form-label">Status</label>
                            <select class="form-select form-select-sm" name="status">
                                <option value="new">New</option>
                                <option value="contacted">Contacted</option>
                                <option value="confirmed">Confirmed</option>
                            </select>
                        </div>
                        <div class="col-6 mb-2"><label class="form-label">Scheduled Date</label><input type="date" class="form-control form-control-sm" name="scheduled_date"></div>
                        <div class="col-12 mb-2"><label class="form-label">Notes</label><textarea class="form-control form-control-sm" name="notes" rows="2" placeholder="Any notes about this invitation..."></textarea></div>
                    </div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary btn-sm">Add Invitation</button></div>
            </form>
        </div>
    </div>
</div>
