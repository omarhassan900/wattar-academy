<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unbound Gym Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.7);
            padding: 12px 20px;
            border-radius: 8px;
            margin: 4px 10px;
            transition: all 0.3s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }
        .main-content { background-color: #f4f6f9; min-height: 100vh; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .btn-primary { background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%); border: none; }
        .btn-primary:hover { background: linear-gradient(135deg, #c0392b 0%, #a93226 100%); }
        .user-info { background: rgba(255,255,255,0.08); border-radius: 10px; padding: 12px; margin: 10px; color: #fff; }
        .brand-logo { font-weight: 800; font-size: 1.4rem; color: #fff; letter-spacing: 1px; }
        .stat-card { border-left: 4px solid; }
        @media (max-width: 991.98px) { .sidebar { min-height: auto; } }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <!-- Mobile Navbar -->
        <nav class="navbar navbar-light bg-white shadow-sm d-lg-none">
            <div class="container-fluid">
                <button class="btn btn-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="brand-logo text-dark"><img src="/images/logo.jpeg" alt="Unbound" style="height:45px; border-radius:6px; margin-right:8px;">UNBOUND</span>
                <span></span>
            </div>
        </nav>

        <!-- Desktop Sidebar -->
        <div class="col-lg-2 d-none d-lg-block sidebar p-0">
            <div class="text-center py-4">
                <img src="/images/logo.jpeg" alt="Unbound" style="height: 80px; border-radius: 8px; margin-bottom: 8px;">
                <div class="brand-logo">UNBOUND</div>
                <small class="text-white-50">Gym Management</small>
            </div>
            <div class="user-info">
                <small class="d-block text-white-50">Logged in as</small>
                <strong><%= user.full_name %></strong>
                <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
            </div>
            <nav class="nav flex-column mt-3">
                <% if (['admin','manager'].includes(user.role)) { %>
                <a class="nav-link <%= currentUrl.startsWith('/dashboard') ? 'active' : '' %>" href="/dashboard"><i class="fas fa-chart-line me-2"></i>Dashboard</a>
                <% } %>
                <a class="nav-link <%= currentUrl.startsWith('/members') ? 'active' : '' %>" href="/members"><i class="fas fa-users me-2"></i>Members</a>
                <a class="nav-link <%= currentUrl.startsWith('/attendance') ? 'active' : '' %>" href="/attendance"><i class="fas fa-clipboard-check me-2"></i>Attendance</a>
                <a class="nav-link <%= currentUrl.startsWith('/classes') ? 'active' : '' %>" href="/classes"><i class="fas fa-dumbbell me-2"></i>Classes</a>
                <a class="nav-link <%= currentUrl.startsWith('/schedule') ? 'active' : '' %>" href="/schedule"><i class="fas fa-calendar-alt me-2"></i>Schedule</a>
                <a class="nav-link <%= currentUrl.startsWith('/wods') ? 'active' : '' %>" href="/wods"><i class="fas fa-fire me-2"></i>WODs</a>
                <a class="nav-link <%= currentUrl.startsWith('/memberships') ? 'active' : '' %>" href="/memberships"><i class="fas fa-id-card me-2"></i>Memberships</a>
                <a class="nav-link <%= currentUrl.startsWith('/payments') ? 'active' : '' %>" href="/payments"><i class="fas fa-money-bill me-2"></i>Payments</a>
                <% if (['admin','manager'].includes(user.role)) { %>
                <a class="nav-link <%= currentUrl.startsWith('/coaches') ? 'active' : '' %>" href="/coaches"><i class="fas fa-user-tie me-2"></i>Coaches</a>
                <% } %>
                <hr class="border-light mx-3">
                <a class="nav-link text-danger" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a>
            </nav>
        </div>

        <!-- Mobile Offcanvas Sidebar -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); max-width: 280px;">
            <div class="offcanvas-header">
                <div class="brand-logo"><img src="/images/logo.jpeg" alt="Unbound" style="height:50px; border-radius:6px; margin-right:8px;">UNBOUND</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body p-0">
                <div class="user-info">
                    <small class="d-block text-white-50">Logged in as</small>
                    <strong class="text-white"><%= user.full_name %></strong>
                </div>
                <nav class="nav flex-column mt-2">
                    <% if (['admin','manager'].includes(user.role)) { %>
                    <a class="nav-link text-white" href="/dashboard"><i class="fas fa-chart-line me-2"></i>Dashboard</a>
                    <% } %>
                    <a class="nav-link text-white" href="/members"><i class="fas fa-users me-2"></i>Members</a>
                    <a class="nav-link text-white" href="/attendance"><i class="fas fa-clipboard-check me-2"></i>Attendance</a>
                    <a class="nav-link text-white" href="/classes"><i class="fas fa-dumbbell me-2"></i>Classes</a>
                    <a class="nav-link text-white" href="/schedule"><i class="fas fa-calendar-alt me-2"></i>Schedule</a>
                    <a class="nav-link text-white" href="/wods"><i class="fas fa-fire me-2"></i>WODs</a>
                    <a class="nav-link text-white" href="/memberships"><i class="fas fa-id-card me-2"></i>Memberships</a>
                    <a class="nav-link text-white" href="/payments"><i class="fas fa-money-bill me-2"></i>Payments</a>
                    <% if (['admin','manager'].includes(user.role)) { %>
                    <a class="nav-link text-white" href="/coaches"><i class="fas fa-user-tie me-2"></i>Coaches</a>
                    <% } %>
                    <a class="nav-link text-danger" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-10 main-content p-4">
            <%- body %>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
