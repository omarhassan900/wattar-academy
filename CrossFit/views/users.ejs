<!-- Password Gate -->
<div id="usersPasswordGate" style="position:relative;">
    <div id="usersLockOverlay" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(244,246,249,0.97); z-index:1000; display:flex; align-items:center; justify-content:center;">
        <div class="card shadow" style="width:350px;">
            <div class="card-header text-white text-center" style="background: linear-gradient(135deg, #1a1a2e, #0f3460); position:relative;">
                <h5 class="mb-0"><i class="fas fa-lock me-2"></i>User Management Locked</h5>
                <button onclick="history.back()" style="position:absolute; top:8px; right:10px; background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer;">&times;</button>
            </div>
            <div class="card-body text-center">
                <p class="small text-muted mb-3">Enter manager credentials to access</p>
                <input type="text" class="form-control form-control-sm mb-2" id="usersGateUsername" placeholder="Username..." autocomplete="off">
                <input type="password" class="form-control form-control-sm mb-2" id="usersGatePassword" placeholder="Password..." autocomplete="off">
                <div id="usersGateError" class="text-danger small mb-2" style="display:none;"></div>
                <button type="button" class="btn btn-success btn-sm w-100" id="usersGateUnlockBtn"><i class="fas fa-unlock me-1"></i>Unlock</button>
            </div>
        </div>
    </div>
<script>
(function() {
    <% if (unlocked) { %>
    document.getElementById('usersLockOverlay').style.display = 'none';
    <% } else { %>
    document.getElementById('usersGateUnlockBtn').addEventListener('click', unlockUsers);
    document.getElementById('usersGatePassword').addEventListener('keydown', function(e) { if (e.key === 'Enter') unlockUsers(); });
    function unlockUsers() {
        var username = document.getElementById('usersGateUsername').value.trim();
        var password = document.getElementById('usersGatePassword').value;
        if (!username || !password) { document.getElementById('usersGateError').textContent = 'Enter username and password'; document.getElementById('usersGateError').style.display = 'block'; return; }
        fetch('/users/verify-access', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: username, password: password }) })
        .then(function(r) { return r.json(); }).then(function(d) {
            if (d.success) { window.location.href = '/users?t=' + d.token; }
            else { document.getElementById('usersGateError').textContent = d.error || 'Access denied'; document.getElementById('usersGateError').style.display = 'block'; }
        });
    }
    <% } %>
})();
</script>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-user-cog me-2"></i>User Management</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fas fa-user-plus me-2"></i>Add User
    </button>
</div>

<div class="card">
    <div class="card-header"><h6 class="mb-0">All Users (<%= users.length %>)</h6></div>
    <div class="card-body table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Username</th><th>Full Name</th><th>Email</th><th>Role</th><th>Status</th><th>Created</th><th>Actions</th></tr>
            </thead>
            <tbody>
                <% users.forEach(u => { %>
                <tr data-id="<%= u.id %>" data-username="<%= u.username %>" data-fullname="<%= u.full_name %>" data-email="<%= u.email || '' %>" data-role="<%= u.role %>" data-status="<%= u.status %>">
                    <td><strong><%= u.username %></strong></td>
                    <td><%= u.full_name %></td>
                    <td><%= u.email || '—' %></td>
                    <td>
                        <% if (u.role === 'admin') { %>
                            <span class="badge bg-danger"><i class="fas fa-shield-alt me-1"></i>Admin</span>
                        <% } else if (u.role === 'manager') { %>
                            <span class="badge bg-warning text-dark"><i class="fas fa-user-tie me-1"></i>Manager</span>
                        <% } else if (u.role === 'reception') { %>
                            <span class="badge bg-info"><i class="fas fa-desktop me-1"></i>Reception</span>
                        <% } else if (u.role === 'coach') { %>
                            <span class="badge bg-success"><i class="fas fa-dumbbell me-1"></i>Coach</span>
                        <% } else if (u.role === 'sales') { %>
                            <span class="badge bg-primary"><i class="fas fa-handshake me-1"></i>Sales</span>
                        <% } else { %>
                            <span class="badge bg-secondary"><%= u.role %></span>
                        <% } %>
                    </td>
                    <td><span class="badge bg-<%= u.status === 'active' ? 'success' : 'secondary' %>"><%= u.status %></span></td>
                    <td><%= u.created_at ? new Date(u.created_at).toLocaleDateString() : '' %></td>
                    <td>
                        <button class="btn btn-sm btn-outline-dark edit-user-btn"><i class="fas fa-edit"></i></button>
                        <% if (u.id !== 1) { %>
                        <button class="btn btn-sm btn-outline-danger delete-user-btn"><i class="fas fa-trash"></i></button>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% if (users.length === 0) { %><p class="text-muted text-center">No users yet.</p><% } %>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/users">
                <div class="modal-header"><h5 class="modal-title">Add New User</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Username *</label><input type="text" class="form-control" name="username" required></div>
                    <div class="mb-3"><label class="form-label">Password *</label><input type="password" class="form-control" name="password" required minlength="6"><small class="text-muted">Minimum 6 characters</small></div>
                    <div class="mb-3"><label class="form-label">Full Name *</label><input type="text" class="form-control" name="full_name" required></div>
                    <div class="mb-3"><label class="form-label">Email</label><input type="email" class="form-control" name="email"></div>
                    <div class="mb-3">
                        <label class="form-label">Role *</label>
                        <select class="form-select" name="role" required>
                            <option value="">Select Role</option>
                            <% if (user.role === 'admin') { %><option value="admin">Admin — Full system access</option><% } %>
                            <option value="manager">Manager — Dashboard, members, payments</option>
                            <option value="reception">Reception — Check-ins & member management</option>
                            <option value="coach">Coach — Schedule, WODs, attendance</option>
                            <option value="sales">Sales — Member registration & sales tracking</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" name="status">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary">Add User</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editUserForm" method="POST">
                <div class="modal-header"><h5 class="modal-title">Edit User</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Username</label><input type="text" class="form-control" id="edit_username" readonly></div>
                    <div class="mb-3"><label class="form-label">New Password</label><input type="password" class="form-control" id="edit_password" name="password" minlength="6"><small class="text-muted">Leave blank to keep current</small></div>
                    <div class="mb-3"><label class="form-label">Full Name *</label><input type="text" class="form-control" id="edit_full_name" name="full_name" required></div>
                    <div class="mb-3"><label class="form-label">Email</label><input type="email" class="form-control" id="edit_email" name="email"></div>
                    <div class="mb-3">
                        <label class="form-label">Role *</label>
                        <select class="form-select" id="edit_role" name="role" required>
                            <% if (user.role === 'admin') { %><option value="admin">Admin</option><% } %>
                            <option value="manager">Manager</option>
                            <option value="reception">Reception</option>
                            <option value="coach">Coach</option>
                            <option value="sales">Sales</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="edit_status" name="status">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary">Save Changes</button></div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('click', function(e) {
        if (e.target.closest('.edit-user-btn')) {
            const row = e.target.closest('tr');
            document.getElementById('edit_username').value = row.dataset.username;
            document.getElementById('edit_full_name').value = row.dataset.fullname;
            document.getElementById('edit_email').value = row.dataset.email;
            document.getElementById('edit_role').value = row.dataset.role;
            document.getElementById('edit_status').value = row.dataset.status;
            document.getElementById('edit_password').value = '';
            document.getElementById('editUserForm').action = '/users/' + row.dataset.id + '/edit';
            new bootstrap.Modal(document.getElementById('editUserModal')).show();
        }
        if (e.target.closest('.delete-user-btn')) {
            if (confirm('Delete this user?')) {
                const row = e.target.closest('tr');
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/users/' + row.dataset.id + '/delete';
                document.body.appendChild(form);
                form.submit();
            }
        }
    });
});
</script>

</div><!-- close usersPasswordGate -->
