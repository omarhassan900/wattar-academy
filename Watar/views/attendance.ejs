<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1><i class="fas fa-calendar-check text-primary me-2"></i>Session Attendance Management</h1>
                <% if (typeof totalStudents !== 'undefined') { %>
                <small class="text-muted">Showing <%= students.length %> of <%= totalStudents %> students (Page <%= currentPage %> of <%= totalPages %>)</small>
                <% } %>
            </div>
            <% if (user.role !== 'operations_manager') { %>
            <div>
                <a href="/attendance/export-csv" class="btn btn-success btn-lg me-2 mb-2">
                    <i class="fas fa-file-csv me-2"></i>Export to CSV
                </a>
                <button type="button" class="btn btn-primary btn-lg mb-2" onclick="saveAllAttendance()">
                    <i class="fas fa-save me-2"></i>Save All Attendance
                </button>
            </div>
            <% } else { %>
            <div>
                <span class="badge bg-info fs-6">
                    <i class="fas fa-eye me-2"></i>View Only Mode
                </span>
            </div>
            <% } %>
        </div>
    </div>
</div>

<% if (students) { %>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-users me-2"></i>
                    Active Students - Session Attendance
                </h5>
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
                        </li>
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <% if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
                                <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= p %>"><%= p %></a>
                                </li>
                            <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            <% } %>
                        <% } %>
                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
                        </li>
                    </ul>
                </nav>
                <% } %>
            </div>
            <div class="card-body">
                <form id="filterForm" method="GET" action="/attendance">
                    <div class="row mb-3">
                        <div class="col-md-3 mb-2">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" class="form-control" name="search" id="studentSearch" 
                                       placeholder="Search by name or phone" 
                                       value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" autofocus>
                            </div>
                        </div>
                        <div class="col-md-2  mb-2">
                            <select class="form-select" name="month" id="monthFilter">
                                <option value="">All Months</option>
                                <% if (typeof activeLevels !== 'undefined' && activeLevels.length > 0) { %>
                                    <% activeLevels.forEach(level => { %>
                                        <option value="<%= level %>" <%= (typeof monthFilter !== 'undefined' && monthFilter === level) ? 'selected' : '' %>>
                                            <%= level %>
                                        </option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-2  mb-2">
                            <select class="form-select" name="instrument" id="instrumentFilter">
                                <option value="">All Instruments</option>
                                <% if (instruments && instruments.length > 0) { %>
                                    <% instruments.forEach(inst => { %>
                                        <option value="<%= inst %>" <%= (typeof instrumentFilter !== 'undefined' && instrumentFilter === inst) ? 'selected' : '' %>>
                                            <%= inst %>
                                        </option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-2  mb-2">
                            <select class="form-select" name="status" id="statusFilter">
                                <option value="">All Status</option>
                                <option value="active" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'active') ? 'selected' : '' %>>Active</option>
                                <option value="inactive" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'inactive') ? 'selected' : '' %>>Inactive</option>
                                <option value="freez" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'freez') ? 'selected' : '' %>>Freez</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <input type="date" class="form-control" name="date" id="dateFilter" 
                                   value="<%= typeof dateFilter !== 'undefined' ? dateFilter : '' %>"
                                   placeholder="Filter by date">
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-filter"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 150px;">Student Name</th>
                                    <th style="width: 100px;">Month</th>
                                    <th style="width: 100px;">Instrument</th>
                                    <th style="width: 80px;">Status</th>
                                    <th style="width: 100px;">Phone</th>
                                    <th class="text-center" style="width: 80px;">Session 1</th>
                                    <th class="text-center" style="width: 80px;">Session 2</th>
                                    <th class="text-center" style="width: 80px;">Session 3</th>
                                    <th class="text-center" style="width: 80px;">Session 4</th>
                                    <th class="text-center" style="width: 60px;">Paid</th>
                                    <th class="text-center" style="width: 100px;">Feedback</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% students.forEach(student => { %>
                                <tr class="student-row" 
                                    data-student-name="<%= student.name.toLowerCase() %>" 
                                    data-month="<%= student.current_level.toLowerCase() %>"
                                    data-instrument="<%= (student.instrument || '').toLowerCase() %>"
                                    data-status="<%= student.status.toLowerCase() %>">
                                    <td>
                                        <strong><%= student.name %></strong>
                                        <% if (student.confirmation) { %>
                                            <% if (student.confirmation.status === 'confirmed') { %>
                                                <span class="badge bg-success ms-2" title="<%= student.confirmation.notes %>">
                                                    <i class="fas fa-check-circle"></i> Confirmed
                                                </span>
                                            <% } else if (student.confirmation.status === 'not_confirmed') { %>
                                                <span class="badge bg-danger ms-2" title="<%= student.confirmation.notes %>">
                                                    <i class="fas fa-times-circle"></i> Not Confirmed
                                                </span>
                                            <% } %>
                                            <% if (student.confirmation.notes) { %>
                                                <br><small class="text-muted"><%= student.confirmation.notes %></small>
                                            <% } %>
                                        <% } %>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm month-selector" 
                                                style="width: 110px;"
                                                data-student-id="<%= student.id %>" 
                                                onchange="changeStudentMonth(this)"
                                                <%= user.role === 'operations_manager' ? 'disabled' : '' %>>
                                            <% for (let i = 1; i <= 48; i++) { %>
                                                <option value="<%= i %>" <%= (parseInt(student.current_level.replace('Month ', '')) === i) ? 'selected' : '' %>>Month <%= i %></option>
                                            <% } %>
                                        </select>
                                    </td>
                                    <td>
                                        <span class="badge bg-success"><%= student.instrument || 'N/A' %></span>
                                    </td>
                                    <td>
                                        <span class="badge <%= student.status === 'active' ? 'bg-success' : student.status === 'inactive' ? 'bg-warning' : 'bg-secondary' %>">
                                            <%= student.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted"><%= student.phone || 'N/A' %></small>
                                    </td>
                                    <% for (let sessionNum = 1; sessionNum <= 4; sessionNum++) { %>
                                        <% 
                                        const sessionData = student.sessions.find(s => s.session_number === sessionNum);
                                        const sessionId = sessionData ? sessionData.session_id : null;
                                        const attendanceStatus = sessionData ? sessionData.attendance_status : null;
                                        const sessionDate = sessionData ? sessionData.session_date : null;
                                        %>
                                        <td class="text-center">
                                            <% if (sessionId) { %>
                                                <div class="session-controls" data-session="<%= sessionId %>" data-student-id="<%= student.id %>">
                                                    <div class="btn-group btn-group-sm mb-1" role="group">
                                                        <input type="radio" class="btn-check" 
                                                               name="att_<%= student.id %>_<%= sessionId %>" 
                                                               value="attended" 
                                                               id="att_<%= student.id %>_<%= sessionId %>"
                                                               <%= attendanceStatus === 'present' || attendanceStatus === 'attended' ? 'checked' : '' %>
                                                               <%= user.role === 'operations_manager' ? 'disabled' : '' %>>
                                                        <label class="btn btn-outline-success" 
                                                               for="att_<%= student.id %>_<%= sessionId %>" title="Present">
                                                            <i class="fas fa-check"></i>
                                                        </label>

                                                        <input type="radio" class="btn-check" 
                                                               name="att_<%= student.id %>_<%= sessionId %>" 
                                                               value="absent" 
                                                               id="abs_<%= student.id %>_<%= sessionId %>"
                                                               <%= attendanceStatus === 'absent' ? 'checked' : '' %>
                                                               <%= user.role === 'operations_manager' ? 'disabled' : '' %>>
                                                        <label class="btn btn-outline-danger" 
                                                               for="abs_<%= student.id %>_<%= sessionId %>" title="Absent">
                                                            <i class="fas fa-times"></i>
                                                        </label>
                                                        
                                                        <% if (attendanceStatus) { %>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm clear-attendance-btn" 
                                                                title="Clear attendance"
                                                                onclick="clearAttendance(<%= student.id %>, <%= sessionId %>)"
                                                                <%= user.role === 'operations_manager' ? 'disabled' : '' %>>
                                                            <i class="fas fa-eraser"></i>
                                                        </button>
                                                        <% } %>
                                                    </div>
                                                    <% if (attendanceStatus && sessionDate) { %>
                                                        <div class="small text-muted" style="font-size: 0.7rem;">
                                                            <%= new Date(sessionDate).toLocaleDateString('en-GB', {day: '2-digit', month: '2-digit'}) %>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } else { %>
                                                <span class="text-muted small">-</span>
                                            <% } %>
                                        </td>
                                    <% } %>
                                    <td class="text-center">
                                        <input class="form-check-input paid-toggle" type="checkbox" 
                                            data-student-id="<%= student.id %>" 
                                            data-level="<%= student.current_level %>"
                                            <%= student.paid ? 'checked' : '' %>
                                            <%= user.role === 'operations_manager' ? 'disabled' : '' %>>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-warning feedback-btn" 
                                            data-student-id="<%= student.id %>" 
                                            data-student-name="<%= student.name %>"
                                            data-level="<%= student.current_level %>"
                                            title="Student Feedback"
                                            <%= user.role === 'operations_manager' ? 'disabled' : '' %>>
                                            <i class="fas fa-star"></i>
                                        </button>
                                        <% if (['manager', 'reception'].includes(user.role)) { %>
                                        <button type="button" class="btn btn-sm btn-outline-info generate-link-btn"
                                            data-student-id="<%= student.id %>"
                                            data-level="<%= student.current_level %>"
                                            title="Generate feedback link">
                                            <i class="fas fa-link"></i>
                                        </button>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Instructions:</strong> Mark attended/absent for each session. Session dates are automatically set to today's date when you save.
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<% } else { %>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No Active Students Found</h4>
                <p class="text-muted">Add students to start tracking attendance.</p>
                <a href="/students" class="btn btn-primary">
                    <i class="fas fa-user-plus me-2"></i>Add Students
                </a>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Student Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-star me-2"></i>Student Feedback</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Student:</strong> <span id="fb-student-name"></span></p>
                <p><strong>Level:</strong> <span id="fb-level"></span></p>
                <input type="hidden" id="fb-student-id">
                <input type="hidden" id="fb-level-hidden">
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Trainer Rating <span class="text-muted">(1-5)</span></label>
                    <div class="fb-star-rating" data-field="trainer">
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="1" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="2" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="3" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="4" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="5" style="cursor:pointer;"></i>
                        <input type="hidden" id="fb-trainer-rating" value="">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Student Development <span class="text-muted">(1-5)</span></label>
                    <div class="fb-star-rating" data-field="development">
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="1" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="2" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="3" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="4" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="5" style="cursor:pointer;"></i>
                        <input type="hidden" id="fb-development-rating" value="">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Overall Experience <span class="text-muted">(1-5)</span></label>
                    <div class="fb-star-rating" data-field="experience">
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="1" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="2" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="3" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="4" style="cursor:pointer;"></i>
                        <i class="fas fa-star fb-star text-muted fs-4" data-value="5" style="cursor:pointer;"></i>
                        <input type="hidden" id="fb-experience-rating" value="">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Notes</label>
                    <textarea class="form-control" id="fb-notes" rows="2" placeholder="Any feedback from the student..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="save-feedback-btn"><i class="fas fa-save me-2"></i>Save Feedback</button>
            </div>
        </div>
    </div>
</div>

<script>
// Save all attendance
function saveAllAttendance() {
    const attendanceData = [];
    const studentNotes = {};
    const today = new Date().toISOString().split('T')[0];
    
    // Get all session controls
    document.querySelectorAll('.session-controls').forEach(control => {
        const sessionId = control.getAttribute('data-session');
        
        // Find checked radio button in this control
        const checkedRadio = control.querySelector('input[type="radio"]:checked');
        
        if (checkedRadio) {
            // Extract student ID from the radio name (format: att_STUDENTID_SESSIONID)
            const match = checkedRadio.name.match(/att_(\d+)_(\d+)/);
            if (match) {
                const studentId = match[1];
                const sessId = match[2];
                
                attendanceData.push({
                    student_id: studentId,
                    session_id: sessId,
                    status: checkedRadio.value,
                    date: today
                });
            }
        }
    });
    
    // Collect all student notes
    document.querySelectorAll('.student-notes').forEach(textarea => {
        const studentId = textarea.getAttribute('data-student-id');
        const notes = textarea.value.trim();
        if (notes) {
            studentNotes[studentId] = notes;
        }
    });
    
    if (attendanceData.length === 0 && Object.keys(studentNotes).length === 0) {
        alert('Please mark attendance or add notes for at least one student');
        return;
    }
    
    // Show loading indicator
    const button = event.target.closest('button');
    const originalHTML = button.innerHTML;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    button.disabled = true;
    
    // Send data to server
    fetch('/attendance/save-all', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            attendance: attendanceData,
            student_notes: studentNotes
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            button.innerHTML = '<i class="fas fa-check"></i> Saved!';
            button.classList.remove('btn-primary');
            button.classList.add('btn-success');
            
            // Reload page to show updated data
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        } else {
            alert('Error saving attendance: ' + (data.error || 'Unknown error'));
            button.innerHTML = originalHTML;
            button.disabled = false;
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error saving attendance');
        button.innerHTML = originalHTML;
        button.disabled = false;
    });
}

// Clear attendance for a specific student and session
function clearAttendance(studentId, sessionId) {
    if (!confirm('Clear attendance for this session?')) {
        return;
    }
    
    fetch('/attendance/clear', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            student_id: studentId,
            session_id: sessionId
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Reload page to show updated data
            window.location.reload();
        } else {
            alert('Error clearing attendance: ' + (data.error || 'Unknown error'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error clearing attendance');
    });
}

// Auto-submit form when filters change
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    const monthFilter = document.getElementById('monthFilter');
    const instrumentFilter = document.getElementById('instrumentFilter');
    const statusFilter = document.getElementById('statusFilter');
    const searchInput = document.getElementById('studentSearch');
    
    // Auto-submit on filter change
    if (monthFilter) monthFilter.addEventListener('change', () => filterForm.submit());
    if (instrumentFilter) instrumentFilter.addEventListener('change', () => filterForm.submit());
    if (statusFilter) statusFilter.addEventListener('change', () => filterForm.submit());
    const dateFilter = document.getElementById('dateFilter');
    if (dateFilter) dateFilter.addEventListener('change', () => filterForm.submit());
    
    // Debounced search submission
    //let searchTimeout;
    //if (searchInput) {
    //    searchInput.addEventListener('input', function() {
    //        clearTimeout(searchTimeout);
    //        searchTimeout = setTimeout(() => {
    //            filterForm.submit();
    //        }, 500); // Wait 500ms after user stops typing
    //    });
   // }
});

// Add visual feedback for attendance changes
document.addEventListener('change', function(e) {
    // Handle paid toggle
    if (e.target.classList.contains('paid-toggle')) {
        const studentId = e.target.dataset.studentId;
        const level = e.target.dataset.level;
        const paid = e.target.checked;
        fetch('/api/toggle-payment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_id: studentId, level: level, paid: paid })
        }).then(r => r.json()).then(d => {
            if (!d.success) { e.target.checked = !paid; alert('Error saving payment status'); }
        }).catch(() => { e.target.checked = !paid; });
    }
    if (e.target.type === 'radio' && e.target.name.includes('att_')) {
        const row = e.target.closest('tr');
        if (e.target.value === 'attended') {
            row.style.backgroundColor = '#d4edda';
        } else {
            row.style.backgroundColor = '#f8d7da';
        }
        
        // Remove background after 2 seconds
        setTimeout(() => {
            row.style.backgroundColor = '';
        }, 2000);
    }
});

// Student Feedback Modal
document.addEventListener('DOMContentLoaded', function() {
    const fbModalEl = document.getElementById('feedbackModal');
    if (!fbModalEl) return;
    const fbModal = new bootstrap.Modal(fbModalEl);
    
    // Star click handler
    document.querySelectorAll('.fb-star-rating').forEach(group => {
        const stars = group.querySelectorAll('.fb-star');
        const hidden = group.querySelector('input[type="hidden"]');
        stars.forEach(star => {
            star.addEventListener('click', function() {
                const val = parseInt(this.dataset.value);
                hidden.value = val;
                stars.forEach((s, i) => {
                    s.classList.toggle('text-warning', i < val);
                    s.classList.toggle('text-muted', i >= val);
                });
            });
        });
    });
    
    function setStars(field, val) {
        const group = document.querySelector(`.fb-star-rating[data-field="${field}"]`);
        if (!group) return;
        group.querySelectorAll('.fb-star').forEach((s, i) => {
            s.classList.toggle('text-warning', i < val);
            s.classList.toggle('text-muted', i >= val);
        });
    }
    
    // Open feedback modal
    document.querySelectorAll('.feedback-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const studentId = this.dataset.studentId;
            const studentName = this.dataset.studentName;
            const level = this.dataset.level;
            
            document.getElementById('fb-student-id').value = studentId;
            document.getElementById('fb-student-name').textContent = studentName;
            document.getElementById('fb-level').textContent = level;
            document.getElementById('fb-level-hidden').value = level;
            document.getElementById('fb-trainer-rating').value = '';
            document.getElementById('fb-development-rating').value = '';
            document.getElementById('fb-experience-rating').value = '';
            document.getElementById('fb-notes').value = '';
            document.querySelectorAll('.fb-star').forEach(s => { s.classList.remove('text-warning'); s.classList.add('text-muted'); });
            
            // Load existing feedback
            fetch('/student-feedback/list').then(r=>r.json()).then(d => {
                if (d.success) {
                    const existing = d.feedback.find(f => f.student_id == studentId && f.level === level);
                    if (existing) {
                        if (existing.trainer_rating) { document.getElementById('fb-trainer-rating').value = existing.trainer_rating; setStars('trainer', existing.trainer_rating); }
                        if (existing.development_rating) { document.getElementById('fb-development-rating').value = existing.development_rating; setStars('development', existing.development_rating); }
                        if (existing.experience_rating) { document.getElementById('fb-experience-rating').value = existing.experience_rating; setStars('experience', existing.experience_rating); }
                        if (existing.notes) document.getElementById('fb-notes').value = existing.notes;
                    }
                }
                fbModal.show();
            }).catch(() => fbModal.show());
        });
    });
    
    // Mark buttons for students who already have feedback
    fetch('/student-feedback/list').then(r=>r.json()).then(d => {
        if (d.success && d.feedback.length > 0) {
            d.feedback.forEach(f => {
                var btn = document.querySelector('.feedback-btn[data-student-id="' + f.student_id + '"][data-level="' + f.level + '"]');
                if (btn && f.trainer_rating) {
                    btn.classList.remove('btn-outline-warning');
                    btn.classList.add('btn-success');
                    btn.innerHTML = '<i class="fas fa-check"></i>';
                }
                // Mark link button status
                var linkBtn = document.querySelector('.generate-link-btn[data-student-id="' + f.student_id + '"][data-level="' + f.level + '"]');
                if (linkBtn && f.token && f.trainer_rating) {
                    linkBtn.classList.remove('btn-outline-info');
                    linkBtn.classList.add('btn-success');
                    linkBtn.innerHTML = '<i class="fas fa-check-circle"></i>';
                } else if (linkBtn && f.token && !f.trainer_rating) {
                    linkBtn.classList.remove('btn-outline-info');
                    linkBtn.classList.add('btn-warning');
                    linkBtn.title = 'Link sent - awaiting response';
                }
            });
        }
    });

    // Generate feedback link
    document.querySelectorAll('.generate-link-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var studentId = this.dataset.studentId;
            var level = this.dataset.level;
            var thisBtn = this;
            fetch('/student-feedback/generate-link', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ student_id: studentId, level: level })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (d.success) {
                    var link = window.location.origin + '/feedback/' + d.token;
                    // Fallback clipboard copy for HTTP
                    var textArea = document.createElement('textarea');
                    textArea.value = link;
                    textArea.style.position = 'fixed';
                    textArea.style.left = '-9999px';
                    document.body.appendChild(textArea);
                    textArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textArea);
                    alert('Link copied to clipboard!\n\n' + link);
                    thisBtn.classList.remove('btn-outline-info');
                    thisBtn.classList.add('btn-warning');
                } else { alert('Error: ' + d.error); }
            });
        });
    });

    // Save feedback
    document.getElementById('save-feedback-btn').addEventListener('click', function() {
        fetch('/student-feedback/save', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                student_id: document.getElementById('fb-student-id').value,
                level: document.getElementById('fb-level-hidden').value,
                trainer_rating: document.getElementById('fb-trainer-rating').value || null,
                development_rating: document.getElementById('fb-development-rating').value || null,
                experience_rating: document.getElementById('fb-experience-rating').value || null,
                notes: document.getElementById('fb-notes').value
            })
        }).then(r=>r.json()).then(d => {
            if (d.success) { 
                alert('Feedback saved!'); 
                fbModal.hide();
                // Mark button as submitted
                const btn = document.querySelector(`.feedback-btn[data-student-id="${document.getElementById('fb-student-id').value}"]`);
                if (btn) {
                    btn.classList.remove('btn-outline-warning');
                    btn.classList.add('btn-success');
                    btn.innerHTML = '<i class="fas fa-check"></i>';
                }
            }
            else alert('Error: ' + d.error);
        });
    });
});

// Change student month and reload page
function changeStudentMonth(inputElement) {
    const studentId = inputElement.getAttribute('data-student-id');
    const val = parseInt(inputElement.value);
    if (val < 1 || val > 48 || isNaN(val)) {
        alert('Month must be between 1 and 48');
        return;
    }
    const newMonth = 'Month ' + val;
    
    // Show loading indicator
    inputElement.disabled = true;
    
    // Update student's month
    fetch('/api/update-student-month', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            student_id: studentId,
            month: newMonth
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Reload page to show new sessions
            window.location.reload();
        } else {
            alert('Error updating month: ' + (data.error || 'Unknown error'));
            inputElement.disabled = false;
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error updating month');
        inputElement.disabled = false;
    });
}
</script>
