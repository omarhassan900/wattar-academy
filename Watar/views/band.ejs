<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="fas fa-guitar text-primary me-2"></i>Wattar Band</h1>
            <div>
                <% if (['manager','operations_manager'].includes(user.role)) { %>
                <button class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                    <i class="fas fa-plus me-2"></i>Add Member
                </button>
                <% } %>
                <button type="button" class="btn btn-success btn-lg" onclick="saveBandAttendance()">
                    <i class="fas fa-save me-2"></i>Save Attendance
                </button>
            </div>
        </div>
    </div>
</div>

<% if (members.length === 0) { %>
<div class="card">
    <div class="card-body text-center py-5">
        <i class="fas fa-guitar fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">No Band Members Yet</h4>
        <p class="text-muted">Add students to the band to start tracking rehearsal attendance.</p>
    </div>
</div>
<% } else { %>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Band Members - Rehearsal Attendance (<%= members.length %> members)
            <% if (members.length > 0) { %>
            <span class="badge bg-primary ms-2">Cycle <%= members[0].current_cycle || 1 %></span>
            <% } %>
        </h5>
        <% if (['manager','operations_manager'].includes(user.role) && members.length > 0) { %>
        <div>
            <button class="btn btn-sm btn-secondary me-1" onclick="prevCycle()">
                <i class="fas fa-backward me-1"></i>Previous Cycle
            </button>
            <button class="btn btn-sm btn-warning" onclick="nextCycle()">
                <i class="fas fa-forward me-1"></i>Next Cycle
            </button>
        </div>
        <% } %>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:180px;">Student</th>
                        <th style="width:100px;">Instrument</th>
                        <th style="width:100px;">Band Role</th>
                        <th class="text-center" style="width:100px;">Rehearsal 1</th>
                        <th class="text-center" style="width:100px;">Rehearsal 2</th>
                        <th class="text-center" style="width:100px;">Rehearsal 3</th>
                        <th class="text-center" style="width:100px;">Rehearsal 4</th>
                        <% if (['manager','operations_manager'].includes(user.role)) { %><th style="width:60px;">Remove</th><% } %>
                    </tr>
                </thead>
                <tbody>
                    <% members.forEach(m => { %>
                    <tr>
                        <td><i class="fas fa-user-circle text-primary me-1"></i><strong><%= m.student_name %></strong>
                            <br><small class="text-muted"><%= m.current_level %></small>
                        </td>
                        <td><span class="badge bg-success"><%= m.student_instrument || 'N/A' %></span></td>
                        <td><%= m.instrument_role || '-' %></td>
                        <% for (let r = 0; r < 4; r++) { %>
                            <% const reh = m.rehearsals[r]; %>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check"
                                        name="band_<%= m.student_id %>_<%= r+1 %>"
                                        value="present"
                                        id="bp_<%= m.student_id %>_<%= r+1 %>"
                                        <%= reh.status === 'present' ? 'checked' : '' %>>
                                    <label class="btn btn-outline-success" for="bp_<%= m.student_id %>_<%= r+1 %>" title="Present">
                                        <i class="fas fa-check"></i>
                                    </label>
                                    <input type="radio" class="btn-check"
                                        name="band_<%= m.student_id %>_<%= r+1 %>"
                                        value="absent"
                                        id="ba_<%= m.student_id %>_<%= r+1 %>"
                                        <%= reh.status === 'absent' ? 'checked' : '' %>>
                                    <label class="btn btn-outline-danger" for="ba_<%= m.student_id %>_<%= r+1 %>" title="Absent">
                                        <i class="fas fa-times"></i>
                                    </label>
                                    <% if (reh.status) { %>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" title="Clear"
                                        onclick="clearBandAttendance(<%= m.student_id %>, <%= r+1 %>)">
                                        <i class="fas fa-eraser"></i>
                                    </button>
                                    <% } %>
                                </div>
                                <% if (reh.date) { %>
                                <div class="small text-muted" style="font-size:0.7rem;"><%= new Date(reh.date).toLocaleDateString('en-GB',{day:'2-digit',month:'2-digit'}) %></div>
                                <% } %>
                            </td>
                        <% } %>
                        <% if (['manager','operations_manager'].includes(user.role)) { %>
                        <td>
                            <button class="btn btn-sm btn-danger remove-member-btn" data-id="<%= m.student_id %>" data-name="<%= m.student_name %>">
                                <i class="fas fa-times"></i>
                            </button>
                        </td>
                        <% } %>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<% } %>

<!-- Add Member Modal -->
<div class="modal fade" id="addMemberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Add Band Member</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Student *</label>
                    <select class="form-select" id="add-member-student">
                        <option value="">Select Student</option>
                        <% const memberIds = members.map(m => m.student_id); %>
                        <% students.forEach(s => { %>
                            <% if (!memberIds.includes(s.id)) { %>
                            <option value="<%= s.id %>"><%= s.name %> (<%= s.instrument || 'No instrument' %> - <%= s.current_level %>)</option>
                            <% } %>
                        <% }); %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Band Role / Instrument in Band</label>
                    <input type="text" class="form-control" id="add-member-role" placeholder="e.g. Lead Guitar, Vocalist, Drums...">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save-member-btn"><i class="fas fa-save me-2"></i>Add to Band</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Add member
    document.getElementById('save-member-btn').addEventListener('click', function() {
        const student_id = document.getElementById('add-member-student').value;
        if (!student_id) return alert('Please select a student');
        fetch('/band/add-member', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ student_id, instrument_role: document.getElementById('add-member-role').value })
        }).then(r=>r.json()).then(d => {
            if (d.success) { alert('Member added to band!'); location.reload(); }
            else alert('Error: ' + d.error);
        });
    });

    // Remove member
    document.querySelectorAll('.remove-member-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (!confirm(`Remove ${this.dataset.name} from the band?`)) return;
            fetch('/band/remove-member', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ student_id: this.dataset.id })
            }).then(r=>r.json()).then(d => {
                if (d.success) location.reload();
                else alert('Error: ' + d.error);
            });
        });
    });

    // Visual feedback on change
    document.addEventListener('change', function(e) {
        if (e.target.type === 'radio' && e.target.name.startsWith('band_')) {
            const row = e.target.closest('tr');
            row.style.backgroundColor = e.target.value === 'present' ? '#d4edda' : '#f8d7da';
            setTimeout(() => { row.style.backgroundColor = ''; }, 2000);
        }
    });
});

function saveBandAttendance() {
    const data = [];
    document.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
        const match = radio.name.match(/band_(\d+)_(\d+)/);
        if (match) {
            data.push({ student_id: match[1], rehearsal_number: parseInt(match[2]), status: radio.value });
        }
    });
    if (data.length === 0) { alert('Please mark attendance for at least one member'); return; }
    
    const btn = event.target.closest('button');
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    btn.disabled = true;
    
    fetch('/band/save-attendance', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ attendance: data })
    }).then(r=>r.json()).then(d => {
        if (d.success) {
            btn.innerHTML = '<i class="fas fa-check"></i> Saved!';
            btn.classList.remove('btn-success');
            btn.classList.add('btn-success');
            setTimeout(() => location.reload(), 1000);
        } else {
            alert('Error: ' + d.error);
            btn.innerHTML = orig; btn.disabled = false;
        }
    }).catch(() => { btn.innerHTML = orig; btn.disabled = false; });
}

function clearBandAttendance(studentId, rehearsalNumber) {
    if (!confirm('Clear this rehearsal attendance?')) return;
    fetch('/band/clear-attendance', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ student_id: studentId, rehearsal_number: rehearsalNumber })
    }).then(r=>r.json()).then(d => {
        if (d.success) location.reload();
        else alert('Error: ' + d.error);
    });
}

function nextCycle() {
    fetch('/band/next-cycle', {
        method: 'POST', headers: {'Content-Type':'application/json'}
    }).then(r=>r.json()).then(d => {
        if (d.success) location.reload();
        else alert('Error: ' + d.error);
    });
}

function prevCycle() {
    fetch('/band/prev-cycle', {
        method: 'POST', headers: {'Content-Type':'application/json'}
    }).then(r=>r.json()).then(d => {
        if (d.success) location.reload();
        else alert('Error: ' + d.error);
    });
}
</script>