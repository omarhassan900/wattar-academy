<div class="row mb-4">
    <div class="col-12">
        <h1><i class="fas fa-chart-line text-primary me-2"></i>Cash Forecast</h1>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-2">
        <div class="card text-center border-primary">
            <div class="card-body py-2">
                <div class="text-muted small">Private</div>
                <div class="fs-4 fw-bold text-primary"><%= privateCount %></div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-info">
            <div class="card-body py-2">
                <div class="text-muted small">Group</div>
                <div class="fs-4 fw-bold text-info"><%= groupCount %></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success">
            <div class="card-body py-2">
                <div class="text-muted small">Expected Monthly Income</div>
                <div class="fs-4 fw-bold text-success"><%= expectedIncome.toLocaleString() %> LE</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-success">
            <div class="card-body py-2">
                <div class="text-muted small">Paid</div>
                <div class="fs-4 fw-bold text-success"><%= paidCount %></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-danger">
            <div class="card-body py-2">
                <div class="text-muted small">Unpaid</div>
                <div class="fs-4 fw-bold text-danger"><%= unpaidCount %></div>
            </div>
        </div>
    </div>
</div>

<!-- Student Forecast Table -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-users me-2"></i>Student Payment Forecast</h5>
                <select id="filterType" class="form-select form-select-sm" style="width: 150px;" onchange="filterForecast()">
                    <option value="">All Types</option>
                    <option value="Private">Private</option>
                    <option value="Group">Group</option>
                    <option value="unpaid">Unpaid Only</option>
                </select>
            </div>
            <div class="card-body p-0">
                <div id="chart-filter-info" class="alert alert-warning m-2" style="display:none;"></div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0" id="forecast-table">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Level</th>
                                <th>Type</th>
                                <th>Fee</th>
                                <th>Session 1 Date</th>
                                <th>Sessions</th>
                                <th>Attended</th>
                                <th>Absent</th>
                                <th>Progress</th>
                                <th>Expected End</th>
                                <th>Days Left</th>
                                <th>Paid</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(function(s) { %>
                            <tr data-type="<%= s.session_type || '' %>" data-paid="<%= s.paid ? '1' : '0' %>" data-end="<%= s.expected_end_date || '' %>" data-start="<%= s.first_session_date || '' %>">
                                <td><strong><%= s.name %></strong></td>
                                <td><span class="badge bg-secondary"><%= s.current_level %></span></td>
                                <td>
                                    <span class="badge <%= s.session_type === 'Group' ? 'bg-info' : s.session_type === 'Private' ? 'bg-warning' : 'bg-secondary' %>">
                                        <%= s.session_type || '-' %>
                                    </span>
                                </td>
                                <td><%= s.fee.toLocaleString() %> LE</td>
                                <td><%= s.first_session_date ? new Date(s.first_session_date).toLocaleDateString('en-GB', {day: '2-digit', month: 'short'}) : '-' %></td>
                                <td><%= s.sessions_completed %>/4</td>
                                <td><span class="badge bg-success"><%= s.attended_count %></span></td>
                                <td><span class="badge bg-danger"><%= s.absent_count %></span></td>
                                <td style="min-width: 120px;">
                                    <% if (s.first_session_date) { %>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar 
                                            <%= s.progress >= 90 ? 'bg-danger' : s.progress >= 60 ? 'bg-warning' : 'bg-success' %>"
                                            style="width: <%= s.progress %>%;" role="progressbar">
                                            <%= s.progress %>%
                                        </div>
                                    </div>
                                    <% } else { %>
                                    <span class="text-muted small">No sessions</span>
                                    <% } %>
                                </td>
                                <td><%= s.expected_end_date ? new Date(s.expected_end_date).toLocaleDateString('en-GB', {day: '2-digit', month: 'short'}) : '-' %></td>
                                <td>
                                    <% if (s.days_remaining !== null) { %>
                                    <span class="badge <%= s.days_remaining <= 0 ? 'bg-danger' : s.days_remaining <= 7 ? 'bg-warning' : 'bg-success' %>">
                                        <%= s.days_remaining <= 0 ? 'Overdue' : s.days_remaining + 'd' %>
                                    </span>
                                    <% } else { %>
                                    -
                                    <% } %>
                                </td>
                                <td>
                                    <% if (s.paid) { %>
                                    <span class="badge bg-success"><i class="fas fa-check"></i></span>
                                    <% } else { %>
                                    <span class="badge bg-danger"><i class="fas fa-times"></i></span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Expected Cash by Renewal Date Chart -->
<div class="row mt-4 mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Expected Cash by Week</h5>
            </div>
            <div class="card-body">
                <canvas id="renewalChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Build renewal chart data grouped by week - fixed 2 month range
const students = <%- JSON.stringify(students) %>;
const today = new Date();
today.setHours(0,0,0,0);

// Generate all weeks from 2 months ago to 2 months ahead
function getMonday(d) {
    const day = d.getDay();
    const diff = d.getDate() - day + (day === 0 ? -6 : 1);
    return new Date(d.getFullYear(), d.getMonth(), diff);
}

const startRange = new Date(today);
startRange.setDate(startRange.getDate() - 60);
const endRange = new Date(today);
endRange.setDate(endRange.getDate() + 60);

const allWeeks = [];
let current = getMonday(startRange);
while (current <= endRange) {
    allWeeks.push(current.toISOString().split('T')[0]);
    current = new Date(current);
    current.setDate(current.getDate() + 7);
}

const weekMapOverdue = {};
const weekMapUpcoming = {};
const weekMapRenewal = {};
allWeeks.forEach(w => { weekMapOverdue[w] = 0; weekMapUpcoming[w] = 0; weekMapRenewal[w] = 0; });

students.forEach(s => {
    if (!s.expected_end_date) return;
    const parts = s.expected_end_date.split('-');
    const endDate = new Date(parts[0], parts[1] - 1, parts[2]);
    
    if (s.paid) {
        const renewalDate = new Date(endDate);
        renewalDate.setDate(renewalDate.getDate() + 28);
        const wk = getMonday(renewalDate).toISOString().split('T')[0];
        if (weekMapRenewal[wk] !== undefined) weekMapRenewal[wk] += s.fee;
    } else {
        const startParts = s.first_session_date ? s.first_session_date.split('-') : null;
        const dueDate = startParts ? new Date(startParts[0], startParts[1]-1, startParts[2]) : endDate;
        const wk = getMonday(dueDate).toISOString().split('T')[0];
        
        if (dueDate < today) {
            if (weekMapOverdue[wk] !== undefined) weekMapOverdue[wk] += s.fee;
        } else {
            if (weekMapUpcoming[wk] !== undefined) weekMapUpcoming[wk] += s.fee;
        }
    }
});

const filteredWeeks = allWeeks.filter(w => weekMapOverdue[w] > 0 || weekMapUpcoming[w] > 0 || weekMapRenewal[w] > 0);

const labels = filteredWeeks.map(w => {
    const parts = w.split('-');
    const d = new Date(parts[0], parts[1] - 1, parts[2]);
    return d.toLocaleDateString('en-GB', {day: '2-digit', month: 'short'});
});
const overdueData = filteredWeeks.map(w => weekMapOverdue[w]);
const upcomingData = filteredWeeks.map(w => weekMapUpcoming[w]);
const renewalData = filteredWeeks.map(w => weekMapRenewal[w]);

new Chart(document.getElementById('renewalChart'), {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [
            {
                label: 'Overdue (Unpaid)',
                data: overdueData,
                backgroundColor: 'rgba(220,53,69,0.7)',
                borderColor: 'rgba(220,53,69,1)',
                borderWidth: 1
            },
            {
                label: 'Due Soon (Unpaid)',
                data: upcomingData,
                backgroundColor: 'rgba(255,193,7,0.7)',
                borderColor: 'rgba(255,193,7,1)',
                borderWidth: 1
            },
            {
                label: 'Expected Renewal (Paid)',
                data: renewalData,
                backgroundColor: 'rgba(40,167,69,0.7)',
                borderColor: 'rgba(40,167,69,1)',
                borderWidth: 1
            }
        ]
    },
    options: {
        responsive: true,
        plugins: { legend: { position: 'top' } },
        scales: { 
            x: { stacked: true },
            y: { stacked: true, beginAtZero: true, ticks: { callback: v => v.toLocaleString() + ' LE' } } 
        },
        onClick: function(evt, elements) {
            if (!elements.length) {
                // Click on empty area - reset filter
                document.querySelectorAll('#forecast-table tbody tr').forEach(r => r.style.display = '');
                document.getElementById('chart-filter-info').style.display = 'none';
                return;
            }
            const idx = elements[0].index;
            const datasetIdx = elements[0].datasetIndex;
            const weekKey = filteredWeeks[idx];
            const isPaid = datasetIdx === 2; // 0=overdue, 1=upcoming, 2=renewal
            const isOverdue = datasetIdx === 0;
            const isCollected = false;
            
            document.querySelectorAll('#forecast-table tbody tr').forEach(row => {
                const endDate = row.dataset.end;
                const startDate = row.dataset.start;
                const rowPaid = row.dataset.paid === '1';
                if (!endDate) { row.style.display = 'none'; return; }
                
                let targetDate;
                const p = endDate.split('-');
                const rowEndDate = new Date(p[0], p[1]-1, p[2]);
                
                if (rowPaid && isPaid) {
                    targetDate = new Date(rowEndDate);
                    targetDate.setDate(targetDate.getDate() + 28);
                } else if (startDate) {
                    const sp = startDate.split('-');
                    targetDate = new Date(sp[0], sp[1]-1, sp[2]);
                } else {
                    targetDate = rowEndDate;
                }
                const day = targetDate.getDay();
                const diff = targetDate.getDate() - day + (day === 0 ? -6 : 1);
                const monday = new Date(targetDate.getFullYear(), targetDate.getMonth(), diff);
                const rowWeek = monday.toISOString().split('T')[0];
                
                let match = false;
                if (rowWeek === weekKey) {
                    if (isPaid && rowPaid) match = true;
                    else if (isOverdue && !rowPaid && targetDate < today) match = true;
                    else if (datasetIdx === 1 && !rowPaid && targetDate >= today) match = true;
                }
                row.style.display = match ? '' : 'none';
            });
            
            const info = document.getElementById('chart-filter-info');
            info.style.display = 'block';
            info.innerHTML = '<i class="fas fa-filter me-2"></i>Showing ' + ['overdue', 'due soon', 'renewals'][datasetIdx] + ' for ' + labels[idx] + ' <button class="btn btn-sm btn-outline-secondary ms-2" onclick="clearChartFilter()">Clear</button>';
        }
    }
});

function clearChartFilter() {
    document.querySelectorAll('#forecast-table tbody tr').forEach(r => r.style.display = '');
    document.getElementById('chart-filter-info').style.display = 'none';
}

function filterForecast() {
    const val = document.getElementById('filterType').value;
    document.querySelectorAll('#forecast-table tbody tr').forEach(row => {
        if (!val) { row.style.display = ''; return; }
        if (val === 'unpaid') {
            row.style.display = row.dataset.paid === '0' ? '' : 'none';
        } else {
            row.style.display = row.dataset.type === val ? '' : 'none';
        }
    });
}
</script>
