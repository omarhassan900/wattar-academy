<div class="row mb-4">
    <div class="col-12">
        <h1><i class="fas fa-chart-line text-primary me-2"></i>Cash Forecast</h1>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-2">
        <div class="card text-center border-primary">
            <div class="card-body py-2">
                <div class="text-muted small">Private</div>
                <div class="fs-4 fw-bold text-primary"><%= privateCount %></div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-info">
            <div class="card-body py-2">
                <div class="text-muted small">Group</div>
                <div class="fs-4 fw-bold text-info"><%= groupCount %></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success">
            <div class="card-body py-2">
                <div class="text-muted small">Expected Monthly Income</div>
                <div class="fs-4 fw-bold text-success"><%= expectedIncome.toLocaleString() %> LE</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-success">
            <div class="card-body py-2">
                <div class="text-muted small">Paid</div>
                <div class="fs-4 fw-bold text-success"><%= paidCount %></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-danger">
            <div class="card-body py-2">
                <div class="text-muted small">Unpaid</div>
                <div class="fs-4 fw-bold text-danger"><%= unpaidCount %></div>
            </div>
        </div>
    </div>
</div>

<!-- Student Forecast Table -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-users me-2"></i>Student Payment Forecast</h5>
                <select id="filterType" class="form-select form-select-sm" style="width: 150px;" onchange="filterForecast()">
                    <option value="">All Types</option>
                    <option value="Private">Private</option>
                    <option value="Group">Group</option>
                    <option value="unpaid">Unpaid Only</option>
                </select>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0" id="forecast-table">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Level</th>
                                <th>Type</th>
                                <th>Fee</th>
                                <th>Session 1 Date</th>
                                <th>Sessions</th>
                                <th>Attended</th>
                                <th>Absent</th>
                                <th>Progress</th>
                                <th>Expected End</th>
                                <th>Days Left</th>
                                <th>Paid</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(function(s) { %>
                            <tr data-type="<%= s.session_type || '' %>" data-paid="<%= s.paid ? '1' : '0' %>">
                                <td><strong><%= s.name %></strong></td>
                                <td><span class="badge bg-secondary"><%= s.current_level %></span></td>
                                <td>
                                    <span class="badge <%= s.session_type === 'Group' ? 'bg-info' : s.session_type === 'Private' ? 'bg-warning' : 'bg-secondary' %>">
                                        <%= s.session_type || '-' %>
                                    </span>
                                </td>
                                <td><%= s.fee.toLocaleString() %> LE</td>
                                <td><%= s.first_session_date ? new Date(s.first_session_date).toLocaleDateString('en-GB', {day: '2-digit', month: 'short'}) : '-' %></td>
                                <td><%= s.sessions_completed %>/4</td>
                                <td><span class="badge bg-success"><%= s.attended_count %></span></td>
                                <td><span class="badge bg-danger"><%= s.absent_count %></span></td>
                                <td style="min-width: 120px;">
                                    <% if (s.first_session_date) { %>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar 
                                            <%= s.progress >= 90 ? 'bg-danger' : s.progress >= 60 ? 'bg-warning' : 'bg-success' %>"
                                            style="width: <%= s.progress %>%;" role="progressbar">
                                            <%= s.progress %>%
                                        </div>
                                    </div>
                                    <% } else { %>
                                    <span class="text-muted small">No sessions</span>
                                    <% } %>
                                </td>
                                <td><%= s.expected_end_date ? new Date(s.expected_end_date).toLocaleDateString('en-GB', {day: '2-digit', month: 'short'}) : '-' %></td>
                                <td>
                                    <% if (s.days_remaining !== null) { %>
                                    <span class="badge <%= s.days_remaining <= 0 ? 'bg-danger' : s.days_remaining <= 7 ? 'bg-warning' : 'bg-success' %>">
                                        <%= s.days_remaining <= 0 ? 'Overdue' : s.days_remaining + 'd' %>
                                    </span>
                                    <% } else { %>
                                    -
                                    <% } %>
                                </td>
                                <td>
                                    <% if (s.paid) { %>
                                    <span class="badge bg-success"><i class="fas fa-check"></i></span>
                                    <% } else { %>
                                    <span class="badge bg-danger"><i class="fas fa-times"></i></span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function filterForecast() {
    const val = document.getElementById('filterType').value;
    document.querySelectorAll('#forecast-table tbody tr').forEach(row => {
        if (!val) { row.style.display = ''; return; }
        if (val === 'unpaid') {
            row.style.display = row.dataset.paid === '0' ? '' : 'none';
        } else {
            row.style.display = row.dataset.type === val ? '' : 'none';
        }
    });
}
</script>
