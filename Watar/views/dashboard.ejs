<!-- Welcome -->
<div class="row">
    <div class="col-12">
        <h4 class="mb-4">
            <i class="fas fa-music text-primary me-2"></i>
            Welcome back, <%= user.full_name %>!
        </h4>
    </div>
</div>

<!-- Row 1: Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center border-primary h-100">
            <div class="card-body">
                <i class="fas fa-users fa-2x text-primary mb-2"></i>
                <h3><%= stats.total_students %></h3>
                <p class="text-muted mb-0">Active Students</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-info h-100">
            <div class="card-body">
                <i class="fas fa-chalkboard-teacher fa-2x text-info mb-2"></i>
                <h3><%= stats.total_classes %></h3>
                <p class="text-muted mb-0">Active Classes</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-warning h-100">
            <div class="card-body">
                <i class="fas fa-user-tie fa-2x text-warning mb-2"></i>
                <h3><%= stats.total_trainers %></h3>
                <p class="text-muted mb-0">Active Trainers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success h-100">
            <div class="card-body">
                <i class="fas fa-percentage fa-2x text-success mb-2"></i>
                <h3><%= attendancePercentage %>%</h3>
                <p class="text-muted mb-0">Attendance Rate (30d)</p>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Session Progress Cards -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-tasks me-2"></i>Attendance Progress (All Students)</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <% const progressColors = ['secondary', 'info', 'primary', 'warning', 'success']; %>
                    <% const progressIcons = ['fa-hourglass-start', 'fa-play', 'fa-forward', 'fa-fast-forward', 'fa-check-double']; %>
                    <% const progressLabels = ['Not Started', 'Session 1 Done', 'Session 2 Done', 'Session 3 Done', 'All 4 Done']; %>
                    <% const sp = typeof sessionProgress !== 'undefined' ? sessionProgress : [0,0,0,0,0]; %>
                    <% for (let i = 0; i <= 4; i++) { %>
                    <div class="col">
                        <a href="/attendance?session_progress=<%= i %>" class="text-decoration-none">
                            <div class="card border-<%= progressColors[i] %> h-100" style="cursor:pointer; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                                <div class="card-body py-3">
                                    <i class="fas <%= progressIcons[i] %> fa-2x text-<%= progressColors[i] %> mb-2"></i>
                                    <h2 class="mb-1 text-<%= progressColors[i] %>"><%= sp[i] %></h2>
                                    <p class="text-muted mb-0" style="font-size: 0.85rem;"><%= progressLabels[i] %></p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 2b: Financial Summary Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <h6><i class="fas fa-arrow-down me-2"></i>Total Income</h6>
                <h3 class="mb-0"><%= totalIncome.toLocaleString() %> EGP</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white h-100">
            <div class="card-body">
                <h6><i class="fas fa-arrow-up me-2"></i>Total Expenses</h6>
                <h3 class="mb-0"><%= totalExpense.toLocaleString() %> EGP</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card <%= balance >= 0 ? 'bg-primary' : 'bg-warning' %> text-white h-100">
            <div class="card-body">
                <h6><i class="fas fa-wallet me-2"></i>Balance</h6>
                <h3 class="mb-0"><%= balance.toLocaleString() %> EGP</h3>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Income vs Expenses & Revenue (side by side) -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa-solid fa-money-bill-trend-up me-2"></i>Monthly Income vs Expenses</h5>
                <select id="yearSelector" class="form-select form-select-sm" style="width: 120px;" onchange="window.location.href='/dashboard?year=' + this.value">
                    <% if (typeof availableYears !== 'undefined') { %>
                        <% availableYears.forEach(y => { %>
                            <option value="<%= y %>" <%= (typeof selectedYear !== 'undefined' && selectedYear == y) ? 'selected' : '' %>><%= y %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="card-body">
                <canvas id="studentsChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Monthly Revenue (Excl. Manager Cash)</h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Row 5: Expense & Income by Category (side by side, full width each) -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Expenses by Category</h5>
            </div>
            <div class="card-body">
                <canvas id="expenseCategoryChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Income by Category</h5>
            </div>
            <div class="card-body">
                <canvas id="incomeCategoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Row 6: Students by Month & Instruments (side by side) -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Students by Month</h5>
            </div>
            <div class="card-body">
                <% if (studentsByMonth && studentsByMonth.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr><th>Month</th><th>Students</th><th>Distribution</th></tr></thead>
                        <tbody>
                            <% const totalStudentsByMonth = studentsByMonth.reduce((sum, m) => sum + m.count, 0);
                            studentsByMonth.forEach(month => { 
                                const pct = Math.round((month.count / totalStudentsByMonth) * 100); %>
                            <tr>
                                <td><%= month.current_level %></td>
                                <td><span class="badge bg-primary"><%= month.count %></span></td>
                                <td><div class="progress" style="height: 20px;"><div class="progress-bar bg-primary" style="width: <%= pct %>%"><%= pct %>%</div></div></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <p class="text-muted text-center">No data</p>
                <% } %>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-music me-2"></i>Top Instruments</h5>
            </div>
            <div class="card-body">
                <% if (studentsByInstrument && studentsByInstrument.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr><th>Instrument</th><th>Students</th><th>Distribution</th></tr></thead>
                        <tbody>
                            <% const totalInstrumentStudents = studentsByInstrument.reduce((sum, inst) => sum + inst.count, 0);
                            studentsByInstrument.forEach(instrument => { 
                                const percentage = (instrument.count / totalInstrumentStudents) * 100; %>
                            <tr>
                                <td><%= instrument.instrument %></td>
                                <td><span class="badge bg-success"><%= instrument.count %></span></td>
                                <td><div class="progress" style="height: 20px;"><div class="progress-bar bg-success" style="width: <%= percentage %>%"><%= Math.round(percentage) %>%</div></div></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <p class="text-muted text-center">No data</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Row 7: Recent Attendance & Quick Actions -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Recent Attendance</h5>
            </div>
            <div class="card-body">
                <% if (recentAttendance && recentAttendance.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr><th>Date</th><th>Present</th><th>Absent</th><th>Confirmed</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <% recentAttendance.forEach(day => { %>
                            <tr>
                                <td><%= new Date(day.date).toLocaleDateString('en-GB', {weekday: 'short', day: '2-digit', month: 'short'}) %></td>
                                <td><span class="badge bg-success"><%= day.students_present %></span></td>
                                <td><span class="badge bg-danger"><%= day.students_absent || 0 %></span></td>
                                <td><span class="badge bg-primary"><%= day.students_confirmed || 0 %></span></td>
                                <td>
                                    <% if (day.students_present > 0) { %>
                                        <span class="badge bg-success"><i class="fas fa-check"></i> Recorded</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary"><i class="fas fa-minus"></i> No data</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <p class="text-muted text-center py-4">No recent attendance data</p>
                <% } %>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/attendance" class="btn btn-primary"><i class="fas fa-calendar-check me-2"></i>Mark Attendance</a>
                    <% if (user.role !== 'trainer') { %>
                    <a href="/students" class="btn btn-outline-primary"><i class="fas fa-user-plus me-2"></i>Manage Students</a>
                    <% } %>
                    <a href="/reports" class="btn btn-outline-primary"><i class="fas fa-chart-line me-2"></i>View Reports</a>
                    <% if (user.role === 'manager') { %>
                    <a href="/classes" class="btn btn-outline-primary"><i class="fas fa-chalkboard-teacher me-2"></i>Manage Classes</a>
                    <% } %>
                </div>
                <hr class="my-3">
                <div class="alert alert-info mb-0">
                    <i class="fas fa-user-shield me-2"></i><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Income vs Expenses
    const financeData = <%- JSON.stringify(financeChartData) %>;
    new Chart(document.getElementById('studentsChart'), {
        type: 'line',
        data: {
            labels: financeData.labels,
            datasets: [
                { label: 'Income', data: financeData.income, borderWidth: 2, borderColor: 'rgba(40,167,69,1)', backgroundColor: 'rgba(40,167,69,0.2)', tension: 0.4 },
                { label: 'Expenses', data: financeData.expenses, borderWidth: 2, borderColor: 'rgba(220,53,69,1)', backgroundColor: 'rgba(220,53,69,0.2)', tension: 0.4 }
            ]
        },
        options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true } } }
    });

    // Revenue
    const revenueData = <%- JSON.stringify(revenueChartData) %>;
    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: revenueData.labels,
            datasets: [{
                label: 'Revenue', data: revenueData.revenue,
                backgroundColor: revenueData.revenue.map(v => v >= 0 ? 'rgba(40,167,69,0.7)' : 'rgba(220,53,69,0.7)'),
                borderColor: revenueData.revenue.map(v => v >= 0 ? 'rgba(40,167,69,1)' : 'rgba(220,53,69,1)'), borderWidth: 1
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    // Expenses by Category
    const expCatData = <%- JSON.stringify(expenseByCategoryData) %>;
    new Chart(document.getElementById('expenseCategoryChart'), {
        type: 'bar',
        data: { labels: expCatData.labels, datasets: expCatData.datasets },
        options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } } }
    });

    // Income by Category
    const incCatData = <%- JSON.stringify(incomeByCategoryData) %>;
    new Chart(document.getElementById('incomeCategoryChart'), {
        type: 'bar',
        data: { labels: incCatData.labels, datasets: incCatData.datasets },
        options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } } }
    });
</script>
