<div class="row">
    <div class="col-12">
        <h1 class="mb-4"><i class="fas fa-star text-warning me-2"></i>Students Evaluation</h1>
    </div>
</div>

<!-- Pending Evaluations -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>Pending Evaluations (<%= pending.length %>)</h5>
            </div>
            <div class="card-body">
                <% if (pending.length === 0) { %>
                <p class="text-muted text-center py-3">No students pending evaluation. Students appear here after completing all 4 sessions in their current level.</p>
                <% } else { %>
                <%
                const groupByTrainer = user.role !== 'trainer';
                const pendingGroups = {};
                if (groupByTrainer) {
                    pending.forEach(s => { const k = s.trainer_name || 'No Trainer'; if (!pendingGroups[k]) pendingGroups[k] = []; pendingGroups[k].push(s); });
                } else { pendingGroups[''] = pending; }
                const pendingKeys = Object.keys(pendingGroups).sort((a,b) => a === 'No Trainer' ? 1 : b === 'No Trainer' ? -1 : a.localeCompare(b));
                %>
                <% pendingKeys.forEach(tk => { %>
                <% if (groupByTrainer) { %>
                <h6 class="mt-3 mb-2"><i class="fas fa-user-tie text-primary me-2"></i><%= tk %> <span class="badge bg-secondary"><%= pendingGroups[tk].length %></span></h6>
                <% } %>
                <div class="table-responsive mb-3">
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Level</th>
                                <th>Instrument</th>
                                <th>Session 1</th>
                                <th>Session 2</th>
                                <th>Session 3</th>
                                <th>Session 4</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pendingGroups[tk].forEach(s => { %>
                            <tr>
                                <td><strong><%= s.name %></strong></td>
                                <td><span class="badge bg-primary"><%= s.current_level %></span></td>
                                <td><%= s.instrument || '-' %></td>
                                <% for (let i = 1; i <= 4; i++) { %>
                                    <% const sd = s.sessionDates.find(d => d.session_number === i); %>
                                    <td>
                                        <% if (sd) { %>
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i><%= new Date(sd.session_date).toLocaleDateString('en-GB', {day:'2-digit',month:'short'}) %></span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                <% } %>
                                <td>
                                    <% if (['trainer', 'manager'].includes(user.role)) { %>
                                    <button class="btn btn-sm btn-warning evaluate-btn"
                                        data-id="<%= s.id %>" data-name="<%= s.name %>" data-level="<%= s.current_level %>">
                                        <i class="fas fa-star me-1"></i>Evaluate
                                    </button>
                                    <% } else { %>
                                    <span class="badge bg-secondary">View Only</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Completed Evaluations -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Completed Evaluations (<%= evaluated.length %>)</h5>
            </div>
            <div class="card-body">
                <% if (evaluated.length === 0) { %>
                <p class="text-muted text-center py-3">No evaluations completed yet.</p>
                <% } else { %>
                <%
                const evalGroups = {};
                if (user.role !== 'trainer') {
                    evaluated.forEach(s => { const k = s.trainer_name || 'No Trainer'; if (!evalGroups[k]) evalGroups[k] = []; evalGroups[k].push(s); });
                } else { evalGroups[''] = evaluated; }
                const evalKeys = Object.keys(evalGroups).sort((a,b) => a === 'No Trainer' ? 1 : b === 'No Trainer' ? -1 : a.localeCompare(b));
                %>
                <% evalKeys.forEach(tk => { %>
                <% if (user.role !== 'trainer') { %>
                <h6 class="mt-3 mb-2"><i class="fas fa-user-tie text-primary me-2"></i><%= tk %> <span class="badge bg-secondary"><%= evalGroups[tk].length %></span></h6>
                <% } %>
                <div class="table-responsive mb-3">
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Level</th>
                                <th>Attitude</th>
                                <th>Commitment</th>
                                <th>Development</th>
                                <th>Notes</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% evalGroups[tk].forEach(s => { %>
                            <tr>
                                <td><strong><%= s.name %></strong></td>
                                <td><span class="badge bg-primary"><%= s.current_level %></span></td>
                                <td><%= '★'.repeat(s.attitude_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (s.attitude_rating || 0)) %></span></td>
                                <td><%= '★'.repeat(s.commitment_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (s.commitment_rating || 0)) %></span></td>
                                <td><%= '★'.repeat(s.development_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (s.development_rating || 0)) %></span></td>
                                <td><small><%= s.eval_notes || '-' %></small></td>
                                <td><small><%= new Date(s.evaluated_at).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) %></small></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Past Evaluations (from previous levels) -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Past Evaluations (<%= pastEvaluations.length %>)</h5>
            </div>
            <div class="card-body">
                <% if (pastEvaluations.length === 0) { %>
                <p class="text-muted text-center py-3">No past evaluations from previous levels.</p>
                <% } else { %>
                <%
                const pastGroups = {};
                pastEvaluations.forEach(e => {
                    const k = e.level || 'Unknown';
                    if (!pastGroups[k]) pastGroups[k] = [];
                    pastGroups[k].push(e);
                });
                const pastKeys = Object.keys(pastGroups).sort();
                %>
                <% pastKeys.forEach(level => { %>
                <h6 class="mt-3 mb-2"><i class="fas fa-layer-group text-info me-2"></i>Level: <%= level %> <span class="badge bg-secondary"><%= pastGroups[level].length %></span></h6>
                <div class="table-responsive mb-3">
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Current Level</th>
                                <th>Attitude</th>
                                <th>Commitment</th>
                                <th>Development</th>
                                <th>Notes</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pastGroups[level].forEach(e => { %>
                            <tr>
                                <td><strong><%= e.name %></strong></td>
                                <td><span class="badge bg-primary"><%= e.current_level %></span></td>
                                <td><%= '★'.repeat(e.attitude_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (e.attitude_rating || 0)) %></span></td>
                                <td><%= '★'.repeat(e.commitment_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (e.commitment_rating || 0)) %></span></td>
                                <td><%= '★'.repeat(e.development_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (e.development_rating || 0)) %></span></td>
                                <td><small><%= e.notes || '-' %></small></td>
                                <td><small><%= e.evaluated_at ? new Date(e.evaluated_at).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) : '-' %></small></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Student Feedback -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-purple" style="background-color: #6f42c1;">
                <h5 class="mb-0 text-white"><i class="fas fa-comments me-2"></i>Student Feedback (<%= feedbackList.length %>)</h5>
            </div>
            <div class="card-body">
                <% if (feedbackList.length === 0) { %>
                <p class="text-muted text-center py-3">No student feedback submitted yet.</p>
                <% } else { %>
                <%
                const fbGroups = {};
                feedbackList.forEach(f => {
                    const k = f.trainer_name || 'No Trainer';
                    if (!fbGroups[k]) fbGroups[k] = [];
                    fbGroups[k].push(f);
                });
                const fbKeys = Object.keys(fbGroups).sort((a,b) => a === 'No Trainer' ? 1 : b === 'No Trainer' ? -1 : a.localeCompare(b));
                %>
                <% fbKeys.forEach(trainerName => { %>
                <h6 class="mt-3 mb-2"><i class="fas fa-user-tie me-2" style="color:#6f42c1;"></i><%= trainerName %> <span class="badge bg-secondary"><%= fbGroups[trainerName].length %></span></h6>
                <div class="table-responsive mb-3">
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Level</th>
                                <th>Trainer Rating</th>
                                <th>Development</th>
                                <th>Experience</th>
                                <th>Notes</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% fbGroups[trainerName].forEach(f => { %>
                            <tr>
                                <td><strong><%= f.name %></strong></td>
                                <td><span class="badge bg-primary"><%= f.level %></span></td>
                                <td><%= '★'.repeat(f.trainer_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (f.trainer_rating || 0)) %></span></td>
                                <td><%= '★'.repeat(f.development_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (f.development_rating || 0)) %></span></td>
                                <td><%= '★'.repeat(f.experience_rating || 0) %><span class="text-muted"><%= '☆'.repeat(5 - (f.experience_rating || 0)) %></span></td>
                                <td><small><%= f.notes || '-' %></small></td>
                                <td><small><%= f.created_at ? new Date(f.created_at).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) : '-' %></small></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Evaluate Modal -->
<div class="modal fade" id="evaluateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-star me-2"></i>Evaluate Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Student:</strong> <span id="eval-student-name"></span></p>
                <p><strong>Level:</strong> <span id="eval-level"></span></p>
                <input type="hidden" id="eval-student-id">
                <input type="hidden" id="eval-level-hidden">
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Attitude <span class="text-muted">(1-5)</span></label>
                    <div class="star-rating" data-field="attitude">
                        <% for (let i = 1; i <= 5; i++) { %>
                        <i class="fas fa-star star-btn text-muted fs-4" data-value="<%= i %>" style="cursor:pointer;"></i>
                        <% } %>
                        <input type="hidden" id="eval-attitude" value="">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Commitment <span class="text-muted">(1-5)</span></label>
                    <div class="star-rating" data-field="commitment">
                        <% for (let i = 1; i <= 5; i++) { %>
                        <i class="fas fa-star star-btn text-muted fs-4" data-value="<%= i %>" style="cursor:pointer;"></i>
                        <% } %>
                        <input type="hidden" id="eval-commitment" value="">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Development <span class="text-muted">(1-5)</span></label>
                    <div class="star-rating" data-field="development">
                        <% for (let i = 1; i <= 5; i++) { %>
                        <i class="fas fa-star star-btn text-muted fs-4" data-value="<%= i %>" style="cursor:pointer;"></i>
                        <% } %>
                        <input type="hidden" id="eval-development" value="">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Notes</label>
                    <textarea class="form-control" id="eval-notes" rows="3" placeholder="Any additional feedback..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="save-eval-btn"><i class="fas fa-save me-2"></i>Save Evaluation</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const evalModal = new bootstrap.Modal(document.getElementById('evaluateModal'));

    // Star rating click
    document.querySelectorAll('.star-rating').forEach(group => {
        const field = group.dataset.field;
        const hiddenInput = group.querySelector('input[type="hidden"]');
        const stars = group.querySelectorAll('.star-btn');
        
        stars.forEach(star => {
            star.addEventListener('click', function() {
                const val = parseInt(this.dataset.value);
                hiddenInput.value = val;
                stars.forEach((s, i) => {
                    s.classList.toggle('text-warning', i < val);
                    s.classList.toggle('text-muted', i >= val);
                });
            });
        });
    });

    // Open evaluate modal
    document.querySelectorAll('.evaluate-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('eval-student-id').value = this.dataset.id;
            document.getElementById('eval-student-name').textContent = this.dataset.name;
            document.getElementById('eval-level').textContent = this.dataset.level;
            document.getElementById('eval-level-hidden').value = this.dataset.level;
            document.getElementById('eval-attitude').value = '';
            document.getElementById('eval-commitment').value = '';
            document.getElementById('eval-development').value = '';
            document.getElementById('eval-notes').value = '';
            // Reset stars
            document.querySelectorAll('.star-btn').forEach(s => {
                s.classList.remove('text-warning');
                s.classList.add('text-muted');
            });
            evalModal.show();
        });
    });

    // Save evaluation
    document.getElementById('save-eval-btn').addEventListener('click', function() {
        const attitude = document.getElementById('eval-attitude').value;
        const commitment = document.getElementById('eval-commitment').value;
        const development = document.getElementById('eval-development').value;
        
        if (!attitude || !commitment || !development) {
            alert('Please rate all three criteria');
            return;
        }
        
        fetch('/evaluations/save', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                student_id: document.getElementById('eval-student-id').value,
                level: document.getElementById('eval-level-hidden').value,
                attitude_rating: attitude,
                commitment_rating: commitment,
                development_rating: development,
                notes: document.getElementById('eval-notes').value
            })
        }).then(r=>r.json()).then(d => {
            if (d.success) { alert('Evaluation saved!'); location.reload(); }
            else alert('Error: ' + d.error);
        });
    });
});
</script>