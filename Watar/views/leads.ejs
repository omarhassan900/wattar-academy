<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="fas fa-headset text-primary me-2"></i>Leads</h1>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addLeadModal">
                <i class="fas fa-plus me-2"></i>Add Lead
            </button>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="row mb-4">
    <% const statusCounts = { new: 0, contacted: 0, interested: 0, callback: 0, trial_scheduled: 0, enrolled: 0, not_interested: 0 };
       leads.forEach(l => { if (statusCounts[l.status] !== undefined) statusCounts[l.status]++; }); %>
    <div class="col"><div class="card text-center border-secondary"><div class="card-body py-2"><h4 class="mb-0"><%= statusCounts.new %></h4><small class="text-muted">New</small></div></div></div>
    <div class="col"><div class="card text-center border-info"><div class="card-body py-2"><h4 class="mb-0"><%= statusCounts.contacted %></h4><small class="text-muted">Contacted</small></div></div></div>
    <div class="col"><div class="card text-center border-primary"><div class="card-body py-2"><h4 class="mb-0"><%= statusCounts.interested %></h4><small class="text-muted">Interested</small></div></div></div>
    <div class="col"><div class="card text-center border-warning"><div class="card-body py-2"><h4 class="mb-0"><%= statusCounts.callback %></h4><small class="text-muted">Callback</small></div></div></div>
    <div class="col"><div class="card text-center" style="border-color:#8e44ad;"><div class="card-body py-2"><h4 class="mb-0"><%= statusCounts.trial_scheduled %></h4><small class="text-muted">Trial</small></div></div></div>
    <div class="col"><div class="card text-center border-success"><div class="card-body py-2"><h4 class="mb-0"><%= statusCounts.enrolled %></h4><small class="text-muted">Enrolled</small></div></div></div>
    <div class="col"><div class="card text-center border-danger"><div class="card-body py-2"><h4 class="mb-0"><%= statusCounts.not_interested %></h4><small class="text-muted">Not Interested</small></div></div></div>
</div>

<!-- Filters -->
<div class="row mb-3">
    <div class="col-md-3">
        <input type="text" id="searchLead" class="form-control form-control-sm" placeholder="Search by name or phone...">
    </div>
    <div class="col-md-2">
        <select id="statusFilter" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            <option value="new">New</option>
            <option value="contacted">Contacted</option>
            <option value="interested">Interested</option>
            <option value="callback">Callback</option>
            <option value="trial_scheduled">Trial Scheduled</option>
            <option value="enrolled">Enrolled</option>
            <option value="not_interested">Not Interested</option>
        </select>
    </div>
    <div class="col-md-2">
        <select id="sourceFilter" class="form-select form-select-sm">
            <option value="">All Sources</option>
            <option value="Instagram">Instagram</option>
            <option value="Facebook">Facebook</option>
            <option value="Referral">Referral</option>
            <option value="Walk-in">Walk-in</option>
            <option value="Phone">Phone</option>
            <option value="Other">Other</option>
        </select>
    </div>
</div>

<!-- Leads Table -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Date Added</th>
                                <th>Source</th>
                                <th>Instrument</th>
                                <th>Status</th>
                                <th>Calls</th>
                                <th>Last Call</th>
                                <% if (['manager','operations_manager'].includes(user.role)) { %><th>Assigned To</th><% } %>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (leads.length === 0) { %>
                            <tr><td colspan="9" class="text-center py-4 text-muted">No leads yet</td></tr>
                            <% } %>
                            <% leads.forEach(lead => { %>
                            <tr class="lead-row" 
                                data-name="<%= lead.name.toLowerCase() %>" 
                                data-phone="<%= (lead.phone || '').toLowerCase() %>"
                                data-status="<%= lead.status %>"
                                data-source="<%= lead.source || '' %>">
                                <td><strong><%= lead.name %></strong><% if (lead.age) { %> <small class="text-muted">(<%= lead.age %>y)</small><% } %></td>
                                <td>
                                    <% if (lead.phone) { %><a href="tel:<%= lead.phone %>"><i class="fas fa-phone me-1"></i><%= lead.phone %></a><% } else { %>-<% } %>
                                    <% if (lead.parent_phone) { %><br><small><a href="tel:<%= lead.parent_phone %>"><i class="fas fa-phone me-1"></i><%= lead.parent_phone %></a></small><% } %>
                                </td>
                                <td><small><%= lead.created_at ? new Date(lead.created_at).toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}) : '-' %></small></td>
                                <td><%= lead.source || '-' %></td>
                                <td><%= lead.instrument || '-' %></td>
                                <td>
                                    <% const statusColors = { new: 'secondary', contacted: 'info', interested: 'primary', callback: 'warning', trial_scheduled: 'purple', enrolled: 'success', not_interested: 'danger' }; %>
                                    <span class="badge" style="background-color: <%= lead.status === 'trial_scheduled' ? '#8e44ad' : '' %>;" class="badge bg-<%= statusColors[lead.status] || 'secondary' %>">
                                        <span class="badge bg-<%= statusColors[lead.status] || 'secondary' %>"><%= lead.status.replace(/_/g,' ') %></span>
                                    </span>
                                    <% if (lead.trial_date) { %>
                                        <br><small class="text-muted"><i class="fas fa-calendar me-1"></i><%= lead.trial_date %> <%= lead.trial_time %></small>
                                        <% if (lead.trial_trainer_name) { %><br><small class="text-muted"><i class="fas fa-user-tie me-1"></i><%= lead.trial_trainer_name %></small><% } %>
                                    <% } %>
                                </td>
                                <td><span class="badge bg-light text-dark"><%= lead.call_count || 0 %></span></td>
                                <td>
                                    <% if (lead.last_call_date) { %>
                                        <small><%= new Date(lead.last_call_date).toLocaleDateString('en-GB', {day:'2-digit',month:'short'}) %></small>
                                        <% if (lead.last_call_outcome) { %><br><small class="text-muted"><%= lead.last_call_outcome.replace('_',' ') %></small><% } %>
                                        <% if (lead.callback_date) { %>
                                            <% const cbDate = new Date(lead.callback_date); const now = new Date(); %>
                                            <% if (cbDate <= now) { %>
                                                <br><span class="badge bg-danger"><i class="fas fa-phone-alt"></i> Call now!</span>
                                            <% } else { %>
                                                <br><small class="text-warning"><i class="fas fa-clock"></i> <%= cbDate.toLocaleDateString('en-GB', {day:'2-digit',month:'short'}) %></small>
                                            <% } %>
                                        <% } %>
                                    <% } else { %>-<% } %>
                                </td>
                                <% if (['manager','operations_manager'].includes(user.role)) { %><td><small><%= lead.assigned_to_name || 'Unassigned' %></small></td><% } %>
                                <td>
                                    <% if (['sales', 'manager', 'operations_manager'].includes(user.role)) { %>
                                    <button class="btn btn-sm btn-success log-call-btn" title="Log Call"
                                        data-id="<%= lead.id %>" data-name="<%= lead.name %>">
                                        <i class="fas fa-phone"></i>
                                    </button>
                                    <% } %>
                                    <button class="btn btn-sm btn-info view-calls-btn" title="Call History"
                                        data-id="<%= lead.id %>" data-name="<%= lead.name %>">
                                        <i class="fas fa-history"></i>
                                    </button>
                                    <% if (['sales', 'manager', 'operations_manager'].includes(user.role)) { %>
                                    <button class="btn btn-sm btn-warning edit-lead-btn" title="Edit"
                                        data-lead='<%- JSON.stringify(lead) %>'>
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <% } %>
                                    <% if (['operations_manager', 'manager'].includes(user.role) && lead.status === 'interested') { %>
                                    <button class="btn btn-sm btn-purple schedule-trial-btn" title="Schedule Trial" style="background-color:#8e44ad;color:white;"
                                        data-id="<%= lead.id %>" data-name="<%= lead.name %>">
                                        <i class="fas fa-calendar-plus"></i>
                                    </button>
                                    <% } %>
                                    <% if (['reception', 'manager', 'operations_manager'].includes(user.role) && lead.status === 'trial_scheduled') { %>
                                    <button class="btn btn-sm btn-success enroll-btn" title="Enrolled - Convert to Student"
                                        data-id="<%= lead.id %>" data-name="<%= lead.name %>">
                                        <i class="fas fa-user-plus"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger not-interested-btn" title="Not Interested"
                                        data-id="<%= lead.id %>" data-name="<%= lead.name %>">
                                        <i class="fas fa-times"></i>
                                    </button>
                                    <% } %>
                                    <% if (['manager','operations_manager'].includes(user.role)) { %>
                                    <button class="btn btn-sm btn-danger delete-lead-btn" title="Delete" data-id="<%= lead.id %>">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Lead Modal -->
<div class="modal fade" id="addLeadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Add New Lead</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Name *</label>
                        <input type="text" class="form-control" id="add-lead-name" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" id="add-lead-phone">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Parent Phone</label>
                        <input type="text" class="form-control" id="add-lead-parent-phone">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="add-lead-email">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Age</label>
                        <input type="number" class="form-control" id="add-lead-age">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Instrument</label>
                        <input type="text" class="form-control" id="add-lead-instrument" placeholder="e.g. Guitar, Piano">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Source</label>
                        <select class="form-select" id="add-lead-source">
                            <option value="">Select</option>
                            <option>Instagram</option><option>Facebook</option>
                            <option>Referral</option><option>Walk-in</option>
                            <option>Phone</option><option>Other</option>
                        </select>
                    </div>
                </div>
                <% if (['manager','operations_manager'].includes(user.role)) { %>
                <div class="mb-3">
                    <label class="form-label">Assign To</label>
                    <select class="form-select" id="add-lead-assigned">
                        <option value="">Unassigned</option>
                        <% salesUsers.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.full_name %></option>
                        <% }); %>
                    </select>
                </div>
                <% } %>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" id="add-lead-notes" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save-lead-btn"><i class="fas fa-save me-2"></i>Save Lead</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Lead Modal -->
<div class="modal fade" id="editLeadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Lead</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-lead-id">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Name *</label>
                        <input type="text" class="form-control" id="edit-lead-name" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" id="edit-lead-phone">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Parent Phone</label>
                        <input type="text" class="form-control" id="edit-lead-parent-phone">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="edit-lead-email">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Age</label>
                        <input type="number" class="form-control" id="edit-lead-age">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Instrument</label>
                        <input type="text" class="form-control" id="edit-lead-instrument">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Source</label>
                        <select class="form-select" id="edit-lead-source">
                            <option value="">Select</option>
                            <option>Instagram</option><option>Facebook</option>
                            <option>Referral</option><option>Walk-in</option>
                            <option>Phone</option><option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="edit-lead-status">
                            <option value="new">New</option>
                            <option value="contacted">Contacted</option>
                            <option value="interested">Interested</option>
                            <option value="callback">Callback</option>
                            <option value="enrolled">Enrolled</option>
                            <option value="not_interested">Not Interested</option>
                        </select>
                    </div>
                </div>
                <% if (['manager','operations_manager'].includes(user.role)) { %>
                <div class="mb-3">
                    <label class="form-label">Assign To</label>
                    <select class="form-select" id="edit-lead-assigned">
                        <option value="">Unassigned</option>
                        <% salesUsers.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.full_name %></option>
                        <% }); %>
                    </select>
                </div>
                <% } %>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" id="edit-lead-notes" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="update-lead-btn"><i class="fas fa-save me-2"></i>Update</button>
            </div>
        </div>
    </div>
</div>

<!-- Log Call Modal -->
<div class="modal fade" id="logCallModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-phone me-2"></i>Log Call</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Lead:</strong> <span id="call-lead-name"></span></p>
                <input type="hidden" id="call-lead-id">
                <div class="mb-3">
                    <label class="form-label">Outcome *</label>
                    <select class="form-select" id="call-outcome" required onchange="document.getElementById('callback-time-group').style.display = this.value === 'callback' ? '' : 'none';">
                        <option value="">Select outcome</option>
                        <option value="no_answer">No Answer</option>
                        <option value="callback">Callback Later</option>
                        <option value="interested">Interested</option>
                        <option value="not_interested">Not Interested</option>
                        <option value="enrolled">Enrolled</option>
                    </select>
                </div>
                <div class="mb-3" id="callback-time-group" style="display:none;">
                    <label class="form-label">Callback in (days) *</label>
                    <input type="number" class="form-control" id="call-callback-days" min="1" max="30" placeholder="e.g. 3">
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" id="call-notes" rows="3" placeholder="What was discussed..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="save-call-btn"><i class="fas fa-save me-2"></i>Save Call</button>
            </div>
        </div>
    </div>
</div>

<!-- Call History Modal -->
<div class="modal fade" id="callHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-history me-2"></i>Call History - <span id="history-lead-name"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="call-history-content">Loading...</div>
            </div>
        </div>
    </div>
</div>

<!-- Schedule Trial Modal (Operations Manager) -->
<div class="modal fade" id="scheduleTrialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#8e44ad;color:white;">
                <h5 class="modal-title"><i class="fas fa-calendar-plus me-2"></i>Schedule Trial Session</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Lead:</strong> <span id="trial-lead-name"></span></p>
                <input type="hidden" id="trial-lead-id">
                <div class="mb-3">
                    <label class="form-label">Trial Date *</label>
                    <input type="date" class="form-control" id="trial-date" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Trial Time *</label>
                    <input type="time" class="form-control" id="trial-time" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Trainer</label>
                    <select class="form-select" id="trial-trainer">
                        <option value="">Select Trainer</option>
                        <% if (typeof trainers !== 'undefined' && trainers) { %>
                            <% trainers.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" id="trial-notes" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save-trial-btn" style="background-color:#8e44ad;border:none;"><i class="fas fa-save me-2"></i>Schedule Trial</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const addModal = new bootstrap.Modal(document.getElementById('addLeadModal'));
    const editModal = new bootstrap.Modal(document.getElementById('editLeadModal'));
    const callModal = new bootstrap.Modal(document.getElementById('logCallModal'));
    const historyModal = new bootstrap.Modal(document.getElementById('callHistoryModal'));

    // Filters
    function applyFilters() {
        const search = document.getElementById('searchLead').value.toLowerCase();
        const status = document.getElementById('statusFilter').value;
        const source = document.getElementById('sourceFilter').value;
        document.querySelectorAll('.lead-row').forEach(row => {
            const matchName = !search || row.dataset.name.includes(search) || row.dataset.phone.includes(search);
            const matchStatus = !status || row.dataset.status === status;
            const matchSource = !source || row.dataset.source === source;
            row.style.display = (matchName && matchStatus && matchSource) ? '' : 'none';
        });
    }
    document.getElementById('searchLead').addEventListener('input', applyFilters);
    document.getElementById('statusFilter').addEventListener('change', applyFilters);
    document.getElementById('sourceFilter').addEventListener('change', applyFilters);

    // Save new lead
    document.getElementById('save-lead-btn').addEventListener('click', function() {
        const name = document.getElementById('add-lead-name').value;
        if (!name) return alert('Name is required');
        fetch('/leads/add', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                name, phone: document.getElementById('add-lead-phone').value,
                parent_phone: document.getElementById('add-lead-parent-phone').value,
                email: document.getElementById('add-lead-email').value,
                age: document.getElementById('add-lead-age').value,
                instrument: document.getElementById('add-lead-instrument').value,
                source: document.getElementById('add-lead-source').value,
                notes: document.getElementById('add-lead-notes').value,
                assigned_to: document.getElementById('add-lead-assigned')?.value || ''
            })
        }).then(r=>r.json()).then(d => {
            if (d.success) { alert('Lead added!'); location.reload(); }
            else alert('Error: ' + d.error);
        });
    });

    // Edit lead
    document.querySelectorAll('.edit-lead-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const lead = JSON.parse(this.dataset.lead);
            document.getElementById('edit-lead-id').value = lead.id;
            document.getElementById('edit-lead-name').value = lead.name;
            document.getElementById('edit-lead-phone').value = lead.phone || '';
            document.getElementById('edit-lead-parent-phone').value = lead.parent_phone || '';
            document.getElementById('edit-lead-email').value = lead.email || '';
            document.getElementById('edit-lead-age').value = lead.age || '';
            document.getElementById('edit-lead-instrument').value = lead.instrument || '';
            document.getElementById('edit-lead-source').value = lead.source || '';
            document.getElementById('edit-lead-status').value = lead.status;
            document.getElementById('edit-lead-notes').value = lead.notes || '';
            const assignedEl = document.getElementById('edit-lead-assigned');
            if (assignedEl) assignedEl.value = lead.assigned_to || '';
            editModal.show();
        });
    });

    // Update lead
    document.getElementById('update-lead-btn').addEventListener('click', function() {
        const id = document.getElementById('edit-lead-id').value;
        fetch(`/leads/${id}/update`, {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                name: document.getElementById('edit-lead-name').value,
                phone: document.getElementById('edit-lead-phone').value,
                parent_phone: document.getElementById('edit-lead-parent-phone').value,
                email: document.getElementById('edit-lead-email').value,
                age: document.getElementById('edit-lead-age').value,
                instrument: document.getElementById('edit-lead-instrument').value,
                source: document.getElementById('edit-lead-source').value,
                status: document.getElementById('edit-lead-status').value,
                notes: document.getElementById('edit-lead-notes').value,
                assigned_to: document.getElementById('edit-lead-assigned')?.value || ''
            })
        }).then(r=>r.json()).then(d => {
            if (d.success) { alert('Lead updated!'); location.reload(); }
            else alert('Error: ' + d.error);
        });
    });

    // Delete lead
    document.querySelectorAll('.delete-lead-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (!confirm('Delete this lead and all call history?')) return;
            fetch(`/leads/${this.dataset.id}/delete`, { method: 'POST', headers: {'Content-Type':'application/json'} })
                .then(r=>r.json()).then(d => {
                    if (d.success) location.reload();
                    else alert('Error: ' + d.error);
                });
        });
    });

    // Log call
    document.querySelectorAll('.log-call-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('call-lead-id').value = this.dataset.id;
            document.getElementById('call-lead-name').textContent = this.dataset.name;
            document.getElementById('call-outcome').value = '';
            document.getElementById('call-notes').value = '';
            document.getElementById('call-callback-days').value = '';
            document.getElementById('callback-time-group').style.display = 'none';
            callModal.show();
        });
    });

    document.getElementById('save-call-btn').addEventListener('click', function() {
        const id = document.getElementById('call-lead-id').value;
        const outcome = document.getElementById('call-outcome').value;
        if (!outcome) return alert('Please select an outcome');
        const callbackTime = document.getElementById('call-callback-days').value;
        if (outcome === 'callback' && !callbackTime) return alert('Please enter number of days for callback');
        let callbackDate = null;
        if (outcome === 'callback' && callbackTime) {
            const d = new Date();
            d.setDate(d.getDate() + parseInt(callbackTime));
            callbackDate = d.toISOString().split('T')[0];
        }
        fetch(`/leads/${id}/call`, {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ outcome, notes: document.getElementById('call-notes').value, callback_time: callbackDate })
        }).then(r=>r.json()).then(d => {
            if (d.success) { alert('Call logged!'); location.reload(); }
            else alert('Error: ' + d.error);
        });
    });

    // View call history
    document.querySelectorAll('.view-calls-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('history-lead-name').textContent = this.dataset.name;
            document.getElementById('call-history-content').innerHTML = 'Loading...';
            historyModal.show();
            fetch(`/leads/${this.dataset.id}/calls`).then(r=>r.json()).then(d => {
                if (d.success && d.calls.length > 0) {
                    let html = '<table class="table table-sm"><thead><tr><th>Date</th><th>By</th><th>Outcome</th><th>Notes</th></tr></thead><tbody>';
                    d.calls.forEach(c => {
                        const date = new Date(c.call_date).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
                        const outcomeColors = {no_answer:'secondary',callback:'warning',interested:'primary',not_interested:'danger',enrolled:'success'};
                        html += `<tr><td><small>${date}</small></td><td>${c.caller_name||'-'}</td><td><span class="badge bg-${outcomeColors[c.outcome]||'secondary'}">${c.outcome.replace('_',' ')}</span>${c.callback_time ? '<br><small class="text-warning"><i class="fas fa-clock"></i> ' + new Date(c.callback_time).toLocaleString('en-GB',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) + '</small>' : ''}</td><td>${c.notes||'-'}</td></tr>`;
                    });
                    html += '</tbody></table>';
                    document.getElementById('call-history-content').innerHTML = html;
                } else {
                    document.getElementById('call-history-content').innerHTML = '<p class="text-muted text-center py-3">No calls logged yet</p>';
                }
            });
        });
    });

    // Schedule trial (Operations Manager)
    const trialModalEl = document.getElementById('scheduleTrialModal');
    const trialModal = trialModalEl ? new bootstrap.Modal(trialModalEl) : null;
    
    document.querySelectorAll('.schedule-trial-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('trial-lead-id').value = this.dataset.id;
            document.getElementById('trial-lead-name').textContent = this.dataset.name;
            document.getElementById('trial-date').value = '';
            document.getElementById('trial-time').value = '';
            document.getElementById('trial-trainer').value = '';
            document.getElementById('trial-notes').value = '';
            if (trialModal) trialModal.show();
        });
    });

    const saveTrialBtn = document.getElementById('save-trial-btn');
    if (saveTrialBtn) {
        saveTrialBtn.addEventListener('click', function() {
            const id = document.getElementById('trial-lead-id').value;
            const trial_date = document.getElementById('trial-date').value;
            const trial_time = document.getElementById('trial-time').value;
            if (!trial_date || !trial_time) return alert('Date and time are required');
            fetch(`/leads/${id}/schedule-trial`, {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({
                    trial_date, trial_time,
                    trial_trainer_id: document.getElementById('trial-trainer').value,
                    trial_notes: document.getElementById('trial-notes').value
                })
            }).then(r=>r.json()).then(d => {
                if (d.success) { alert('Trial scheduled!'); location.reload(); }
                else alert('Error: ' + d.error);
            });
        });
    }

    // Enroll (Reception)
    document.querySelectorAll('.enroll-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (!confirm(`Convert "${this.dataset.name}" to a student? This will create a new student record.`)) return;
            fetch(`/leads/${this.dataset.id}/trial-result`, {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ result: 'enrolled' })
            }).then(r=>r.json()).then(d => {
                if (d.success) { alert(`Student created! (ID: ${d.studentId})`); location.reload(); }
                else alert('Error: ' + d.error);
            });
        });
    });

    // Not interested (Reception)
    document.querySelectorAll('.not-interested-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (!confirm(`Mark "${this.dataset.name}" as not interested?`)) return;
            fetch(`/leads/${this.dataset.id}/trial-result`, {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ result: 'not_interested' })
            }).then(r=>r.json()).then(d => {
                if (d.success) { alert('Lead marked as not interested'); location.reload(); }
                else alert('Error: ' + d.error);
            });
        });
    });
});
</script>