<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal — Wattar Academy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            background: linear-gradient(135deg, #1a237e 0%, #283593 40%, #3949ab 100%);
            color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; 
            font-family: 'Cairo', 'Inter', sans-serif; 
            position: relative; overflow: hidden;
        }
        body::before {
            content: '🎵'; position: absolute; top: 10%; left: 10%; font-size: 4rem; opacity: 0.08; animation: float 6s infinite ease-in-out;
        }
        body::after {
            content: '🎸'; position: absolute; bottom: 15%; right: 10%; font-size: 5rem; opacity: 0.08; animation: float 8s infinite ease-in-out reverse;
        }
        @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-20px)} }
        .login-card { background: #fff; color: #1a1a2e; border: none; border-radius: 20px; max-width: 420px; width: 100%; margin: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        .login-header { 
            background: linear-gradient(135deg, #1a237e, #3949ab);
            color: #fff; padding: 2.5rem 2rem; border-radius: 20px 20px 0 0; text-align: center; 
            position: relative; overflow: hidden;
        }
        .login-header::after {
            content: ''; position: absolute; top: -50%; right: -30%; width: 200px; height: 200px;
            border-radius: 50%; background: rgba(255,255,255,0.05);
        }
        .login-header img { height: 70px; margin-bottom: 14px; border-radius: 14px; border: 3px solid rgba(255,255,255,0.2); }
        .login-header h2 { font-weight: 800; margin: 0; font-size: 1.4rem; }
        .login-header p { margin: 6px 0 0; color: rgba(255,255,255,0.7); font-size: 0.9rem; }
        .login-body { padding: 2rem; }
        .form-control { background: #f5f7ff; border: 2px solid #e8eaf6; color: #1a1a2e; border-radius: 10px; padding: 12px 16px; transition: border-color 0.2s; }
        .form-control:focus { background: #fff; border-color: #3949ab; color: #1a1a2e; box-shadow: 0 0 0 3px rgba(57,73,171,0.1); }
        .form-control::placeholder { color: #999; }
        .form-label { color: #333; font-size: 0.85rem; font-weight: 600; }
        .btn-login { 
            background: linear-gradient(135deg, #1a237e, #3949ab);
            color: #fff; border: none; font-weight: 700; padding: 13px; border-radius: 10px; width: 100%;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(26,35,126,0.4); color: #fff; }
        .alert { background: #fff0f0; border-color: #ffcccc; color: #cc0000; border-radius: 10px; }
    </style>
</head>
<body>
<div class="login-card">
    <div class="login-header">
        <img src="/images/logo.jpg" alt="Wattar Academy">
        <h2>Student Portal</h2>
        <p>Wattar Academy 🎶</p>
    </div>
    <div class="login-body">
        <% if (error) { %>
            <div class="alert"><i class="fas fa-exclamation-triangle me-2"></i><%= error %></div>
        <% } %>
        <form action="/portal/login" method="POST">
            <div class="mb-3">
                <label class="form-label"><i class="fas fa-phone me-1"></i>Phone Number</label>
                <input type="text" class="form-control" name="username" placeholder="01xxxxxxxxx" required>
            </div>
            <div class="mb-3">
                <label class="form-label"><i class="fas fa-lock me-1"></i>Password</label>
                <input type="password" class="form-control" name="password" placeholder="Enter password" required>
            </div>
            <button type="submit" class="btn btn-login"><i class="fas fa-sign-in-alt me-2"></i>Login</button>
        </form>
    </div>
</div>
</body>
</html>
