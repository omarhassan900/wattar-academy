<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal — Wattar Academy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #000; color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; }
        .login-card { background: #fff; color: #000; border: 1px solid #e5e5e5; border-radius: 16px; max-width: 400px; width: 100%; margin: 20px; box-shadow: 0 4px 24px rgba(0,0,0,0.3); }
        .login-header { background: #000; color: #fff; padding: 2rem; border-radius: 16px 16px 0 0; text-align: center; }
        .login-header img { height: 50px; margin-bottom: 12px; border-radius: 8px; filter: invert(1); }
        .login-header h2 { font-weight: 800; margin: 0; font-size: 1.3rem; }
        .login-header p { margin: 4px 0 0; color: #999; font-size: 0.85rem; }
        .login-body { padding: 2rem; }
        .form-control { background: #f5f5f5; border: 1px solid #e5e5e5; color: #000; border-radius: 8px; padding: 12px 16px; }
        .form-control:focus { background: #fff; border-color: #000; color: #000; box-shadow: none; }
        .form-control::placeholder { color: #999; }
        .form-label { color: #333; font-size: 0.85rem; font-weight: 600; }
        .btn-login { background: #000; color: #fff; border: none; font-weight: 700; padding: 12px; border-radius: 8px; width: 100%; }
        .btn-login:hover { background: #222; color: #fff; }
        .alert { background: #fff0f0; border-color: #ffcccc; color: #cc0000; border-radius: 8px; }
    </style>
</head>
<body>
<div class="login-card">
    <div class="login-header">
        <img src="/images/logo.jpg" alt="Wattar Academy">
        <h2>Student Portal</h2>
        <p>Wattar Academy</p>
    </div>
    <div class="login-body">
        <% if (error) { %>
            <div class="alert"><i class="fas fa-exclamation-triangle me-2"></i><%= error %></div>
        <% } %>
        <form action="/portal/login" method="POST">
            <div class="mb-3">
                <label class="form-label"><i class="fas fa-phone me-1"></i>Phone Number</label>
                <input type="text" class="form-control" name="username" placeholder="01xxxxxxxxx" required>
            </div>
            <div class="mb-3">
                <label class="form-label"><i class="fas fa-lock me-1"></i>Password</label>
                <input type="password" class="form-control" name="password" placeholder="Enter password" required>
            </div>
            <button type="submit" class="btn btn-login"><i class="fas fa-sign-in-alt me-2"></i>Login</button>
        </form>
    </div>
</div>
</body>
</html>
