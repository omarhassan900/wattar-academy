<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings — Wattar Academy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #1a237e; --primary-light: #3949ab; --accent: #ff6f00; }
        body { background: #f0f2f8; color: #1a1a2e; font-family: 'Cairo', 'Inter', sans-serif; min-height: 100vh; }
        .portal-nav { 
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: #fff; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 4px 20px rgba(26,35,126,0.3);
        }
        .portal-nav .logo { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 1.1rem; color: #fff; }
        .portal-nav .logo img { height: 36px; border-radius: 8px; }
        .portal-nav a { color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
        .portal-nav a:hover { color: #fff; }
        .container-portal { max-width: 550px; margin: 0 auto; padding: 24px 16px; }
        .section-card { background: #fff; border: none; border-radius: 16px; padding: 24px; margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .section-card h4 { color: var(--primary); font-weight: 700; margin-bottom: 20px; }
        .form-control { border-radius: 10px; padding: 12px 16px; border: 2px solid #e8eaf6; transition: border-color 0.2s; }
        .form-control:focus { border-color: var(--primary-light); box-shadow: 0 0 0 3px rgba(57,73,171,0.1); }
        .form-label { font-weight: 600; font-size: 0.85rem; color: #333; }
        .btn-save { 
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            color: #fff; border: none; padding: 12px 28px; border-radius: 10px; font-weight: 700;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(26,35,126,0.3); color: #fff; }
        .avatar-wrapper {
            position: relative; width: 120px; height: 120px; margin: 0 auto 16px;
        }
        .avatar-wrapper img, .avatar-wrapper .avatar-placeholder {
            width: 120px; height: 120px; border-radius: 50%; object-fit: cover;
            border: 4px solid #e8eaf6; box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        }
        .avatar-placeholder {
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            display: flex; align-items: center; justify-content: center;
            font-size: 2.5rem; color: #fff; font-weight: 700;
        }
        .avatar-upload-btn {
            position: absolute; bottom: 4px; right: 4px;
            background: var(--accent); color: #fff; border: 3px solid #fff;
            width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 0.8rem; transition: transform 0.2s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        .avatar-upload-btn:hover { transform: scale(1.1); }
        .rank-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.85rem;
        }
        .msg { font-size: 0.85rem; margin-top: 8px; font-weight: 600; }
        .msg-success { color: #2e7d32; }
        .msg-error { color: #c62828; }
    </style>
</head>
<body>
<nav class="portal-nav">
    <div class="logo"><img src="/images/logo.jpg" alt="Wattar"><span>Settings</span></div>
    <a href="/portal"><i class="fas fa-arrow-left me-1"></i>Back to Portal</a>
</nav>
<div class="container-portal">
    
    <!-- Profile Picture -->
    <div class="section-card" style="text-align:center;">
        <h4><i class="fas fa-camera me-2"></i>Profile Picture</h4>
        <div class="avatar-wrapper">
            <% if (profile.profile_pic) { %>
                <img src="<%= profile.profile_pic %>" id="avatar-preview" alt="Profile">
            <% } else { %>
                <div class="avatar-placeholder" id="avatar-preview"><%= student.name.charAt(0) %></div>
            <% } %>
            <label for="pic-input" class="avatar-upload-btn"><i class="fas fa-camera"></i></label>
            <input type="file" id="pic-input" accept="image/*" style="display:none;" onchange="uploadPic(this)">
        </div>
        <div id="pic-msg" class="msg"></div>
        <small style="color:#999;">Auto-compressed to 400px. Max 1MB.</small>
    </div>

    <!-- Edit Profile -->
    <div class="section-card">
        <h4><i class="fas fa-user-edit me-2"></i>Edit Profile</h4>
        <div class="mb-3">
            <label class="form-label">Display Name</label>
            <input type="text" class="form-control" id="display-name" value="<%= profile.display_name || student.name %>" placeholder="How should we call you?">
        </div>
        <div class="mb-3">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" id="date-of-birth" value="<%= profile.date_of_birth || '' %>">
        </div>
        <div class="mb-3">
            <label class="form-label">Bio</label>
            <textarea class="form-control" id="bio" rows="3" placeholder="Tell us about yourself... what do you love about music?"><%= profile.bio || '' %></textarea>
        </div>
        <button class="btn-save" onclick="saveProfile()"><i class="fas fa-save me-1"></i>Save Profile</button>
        <div id="profile-msg" class="msg"></div>
    </div>

    <!-- Change Password -->
    <div class="section-card">
        <h4><i class="fas fa-lock me-2"></i>Change Password</h4>
        <div class="mb-3">
            <label class="form-label">Current Password</label>
            <input type="password" class="form-control" id="current-pw">
        </div>
        <div class="mb-3">
            <label class="form-label">New Password</label>
            <input type="password" class="form-control" id="new-pw">
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm New Password</label>
            <input type="password" class="form-control" id="confirm-pw">
        </div>
        <button class="btn-save" onclick="changePassword()"><i class="fas fa-key me-1"></i>Update Password</button>
        <div id="pw-msg" class="msg"></div>
    </div>

</div>

<script>
function uploadPic(input) {
    if (!input.files[0]) return;
    const file = input.files[0];
    const msg = document.getElementById('pic-msg');
    msg.textContent = 'Compressing...';
    msg.className = 'msg';
    
    // Compress image client-side before uploading
    compressImage(file, 400, 0.7).then(blob => {
        const formData = new FormData();
        formData.append('profile_pic', blob, 'profile.jpg');
        
        msg.textContent = 'Uploading...';
        fetch('/portal/upload-pic', { method: 'POST', body: formData })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    msg.textContent = '✓ Photo updated!';
                    msg.className = 'msg msg-success';
                    const wrapper = document.querySelector('.avatar-wrapper');
                    const existing = document.getElementById('avatar-preview');
                    if (existing.tagName === 'DIV') {
                        const img = document.createElement('img');
                        img.id = 'avatar-preview';
                        img.src = d.path;
                        img.alt = 'Profile';
                        wrapper.replaceChild(img, existing);
                    } else {
                        existing.src = d.path;
                    }
                } else {
                    msg.textContent = d.error || 'Upload failed';
                    msg.className = 'msg msg-error';
                }
            });
    }).catch(() => {
        msg.textContent = 'Error compressing image';
        msg.className = 'msg msg-error';
    });
}

// Compress image to max dimension and quality
function compressImage(file, maxSize, quality) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                const canvas = document.createElement('canvas');
                let w = img.width, h = img.height;
                if (w > h) { if (w > maxSize) { h = h * maxSize / w; w = maxSize; } }
                else { if (h > maxSize) { w = w * maxSize / h; h = maxSize; } }
                canvas.width = w;
                canvas.height = h;
                canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                canvas.toBlob(blob => blob ? resolve(blob) : reject(), 'image/jpeg', quality);
            };
            img.onerror = reject;
            img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
    });
}

function saveProfile() {
    const data = {
        display_name: document.getElementById('display-name').value,
        bio: document.getElementById('bio').value,
        date_of_birth: document.getElementById('date-of-birth').value
    };
    fetch('/portal/update-profile', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(data)
    }).then(r => r.json()).then(d => {
        const msg = document.getElementById('profile-msg');
        if (d.success) { msg.textContent = '✓ Profile saved!'; msg.className = 'msg msg-success'; }
        else { msg.textContent = d.error; msg.className = 'msg msg-error'; }
    });
}

function changePassword() {
    const current = document.getElementById('current-pw').value;
    const newPw = document.getElementById('new-pw').value;
    const confirm = document.getElementById('confirm-pw').value;
    if (!current || !newPw) return alert('Fill in all fields');
    if (newPw !== confirm) return alert('New passwords do not match');
    if (newPw.length < 6) return alert('Password must be at least 6 characters');
    fetch('/portal/change-password', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ current_password: current, new_password: newPw })
    }).then(r => r.json()).then(d => {
        const msg = document.getElementById('pw-msg');
        if (d.success) {
            msg.textContent = '✓ Password updated!'; msg.className = 'msg msg-success';
            document.getElementById('current-pw').value = '';
            document.getElementById('new-pw').value = '';
            document.getElementById('confirm-pw').value = '';
        } else { msg.textContent = d.error; msg.className = 'msg msg-error'; }
    });
}
</script>
</body>
</html>
