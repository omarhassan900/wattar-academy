<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="fas fa-calendar-week text-primary me-2"></i>Weekly Schedule Template</h1>
            <% if (typeof isReadOnly === 'undefined' || !isReadOnly) { %>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
                <i class="fas fa-plus me-2"></i>Add Student to Schedule
            </button>
            <% } %>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <% if (typeof isReadOnly !== 'undefined' && isReadOnly) { %>
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Weekly Schedule (View Only):</strong> This shows the typical weekly schedule. 
            <% if (user.role === 'trainer') { %>
            You can see students assigned to you.
            <% } else { %>
            Contact operations manager to make changes.
            <% } %>
        </div>
        <% } else { %>
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Weekly Schedule Template:</strong> Add students to their typical weekly time slots. Use this as a reference when confirming sessions.
        </div>
        <% } %>
    </div>
</div>

<!-- Calendar View -->
<div class="row mb-2">
    <div class="col-12">
        <div id="trainer-legend" class="d-flex flex-wrap gap-2 align-items-center" style="font-size: 0.8rem;">
            <span class="text-muted fw-bold me-1"><i class="fas fa-palette me-1"></i>Trainers:</span>
        </div>
    </div>
</div>

<!-- Schedule Table -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 schedule-calendar">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 100px;">Time</th>
                                <th>Sunday</th>
                                <th>Monday</th>
                                <th>Tuesday</th>
                                <th>Wednesday</th>
                                <th>Thursday</th>
                                <th>Friday</th>
                                <th>Saturday</th>
                            </tr>
                        </thead>
                        <tbody id="schedule-body">
                            <!-- Time slots will be generated by JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Schedule Modal -->
<div class="modal fade" id="addScheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-plus-circle me-2"></i>Add Student to Schedule
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="add-day" class="form-label">Day of Week *</label>
                    <select class="form-select" id="add-day" required>
                        <option value="">Select Day</option>
                        <option value="Sunday">Sunday</option>
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Students * <small class="text-muted">(select one or more)</small></label>
                    <div class="input-group mb-2">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="add-student-search" placeholder="Search students...">
                    </div>
                    <div id="add-student-list" style="max-height: 180px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 6px; padding: 4px;">
                        <% if (typeof students !== 'undefined' && students) { %>
                            <% students.forEach(student => { %>
                                <div class="form-check student-check-item px-2 py-1" data-name="<%= student.name.toLowerCase() %>">
                                    <input class="form-check-input add-student-cb" type="checkbox" value="<%= student.id %>" data-level="<%= student.current_level %>" id="add-stu-<%= student.id %>">
                                    <label class="form-check-label" for="add-stu-<%= student.id %>" style="cursor:pointer; font-size:0.88rem;">
                                        <%= student.name %> <span class="text-muted">(<%= student.current_level %>)</span>
                                    </label>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                    <small id="add-student-count" class="text-primary fw-bold mt-1 d-block">0 selected</small>
                </div>
                
                <div class="mb-3">
                    <label for="add-time" class="form-label">Time *</label>
                    <input type="time" class="form-control" id="add-time" required>
                </div>
                
                <div class="mb-3">
                    <label for="add-trainer" class="form-label">Trainer (Optional)</label>
                    <select class="form-select" id="add-trainer">
                        <option value="">No Trainer</option>
                        <% if (typeof trainers !== 'undefined' && trainers) { %>
                            <% trainers.forEach(trainer => { %>
                                <option value="<%= trainer.id %>"><%= trainer.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="add-notes" class="form-label">Notes (Optional)</label>
                    <textarea class="form-control" id="add-notes" rows="2" placeholder="e.g., Bring guitar, Special requirements..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save-schedule-btn">
                    <i class="fas fa-save me-2"></i>Add to Schedule
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Schedule Modal -->
<div class="modal fade" id="editScheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">
                    <i class="fas fa-edit me-2"></i>Edit Schedule
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="edit-day" class="form-label">Day of Week *</label>
                    <select class="form-select" id="edit-day" required>
                        <option value="Sunday">Sunday</option>
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="edit-student" class="form-label">Student *</label>
                    <select class="form-select" id="edit-student" required>
                        <option value="">Select Student</option>
                        <% if (typeof students !== 'undefined' && students) { %>
                            <% students.forEach(student => { %>
                                <option value="<%= student.id %>" data-level="<%= student.current_level %>"><%= student.name %> (<%= student.current_level %>)</option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="edit-time" class="form-label">Time *</label>
                    <input type="time" class="form-control" id="edit-time" required>
                </div>
                
                <div class="mb-3">
                    <label for="edit-trainer" class="form-label">Trainer (Optional)</label>
                    <select class="form-select" id="edit-trainer">
                        <option value="">No Trainer</option>
                        <% if (typeof trainers !== 'undefined' && trainers) { %>
                            <% trainers.forEach(trainer => { %>
                                <option value="<%= trainer.id %>"><%= trainer.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="edit-notes" class="form-label">Notes (Optional)</label>
                    <textarea class="form-control" id="edit-notes" rows="2"></textarea>
                </div>
                
                <input type="hidden" id="edit-schedule-id">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="delete-schedule-btn">
                    <i class="fas fa-trash me-2"></i>Delete
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="update-schedule-btn">
                    <i class="fas fa-save me-2"></i>Update
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.schedule-calendar {
    font-size: 0.82rem;
}

.schedule-calendar th {
    text-align: center;
    vertical-align: middle;
    background-color: #f8f9fa;
    font-weight: 600;
    padding: 5px 4px;
    font-size: 0.8rem;
}

.schedule-calendar td {
    vertical-align: top;
    padding: 4px;
    min-height: 40px;
    position: relative;
}

.schedule-calendar td.time-cell {
    background-color: #f8f9fa;
    font-weight: 600;
    text-align: center;
    vertical-align: middle;
    padding: 3px 4px;
    font-size: 0.8rem;
}

.schedule-slot {
    color: white;
    padding: 4px 6px;
    border-radius: 5px;
    margin-bottom: 4px;
    <% if (typeof isReadOnly === 'undefined' || !isReadOnly) { %>
    cursor: pointer;
    <% } else { %>
    cursor: default;
    <% } %>
    transition: transform 0.2s, box-shadow 0.2s;
    font-size: 0.78rem;
    line-height: 1.3;
}

<% if (typeof isReadOnly === 'undefined' || !isReadOnly) { %>
.schedule-slot:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}
<% } %>

.schedule-slot .student-name {
    font-weight: 600;
    font-size: 0.8rem;
    margin-bottom: 2px;
}

.schedule-slot .student-names {
    margin-bottom: 2px;
}

.schedule-slot .student-name-item {
    display: block;
    font-weight: 600;
    font-size: 0.8rem;
    padding: 1px 0;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}

.schedule-slot .student-name-item:last-child {
    border-bottom: none;
}

.schedule-slot .level-badge {
    background-color: rgba(255,255,255,0.3);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 0.68rem;
    display: inline-block;
    margin-bottom: 2px;
}

.schedule-slot .time-range {
    font-size: 0.65rem;
    opacity: 0.95;
    margin-top: 1px;
    font-weight: 600;
    background-color: rgba(255,255,255,0.2);
    padding: 1px 5px;
    border-radius: 3px;
    display: inline-block;
}

.schedule-slot .trainer-name {
    font-size: 0.68rem;
    opacity: 0.9;
    margin-top: 2px;
}

.schedule-slot .notes-text {
    font-size: 0.65rem;
    opacity: 0.8;
    font-style: italic;
    margin-top: 1px;
}

.empty-slot {
    color: #999;
    font-size: 0.8rem;
    text-align: center;
    padding: 10px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const addScheduleModal = new bootstrap.Modal(document.getElementById('addScheduleModal'));
    const editScheduleModal = new bootstrap.Modal(document.getElementById('editScheduleModal'));
    
    let scheduleData = [];
    
    // Color palette for trainers - each trainer gets a unique gradient
    const trainerColors = [
        'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',  // Purple
        'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',  // Pink
        'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',  // Blue
        'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',  // Green
        'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',  // Rose-Yellow
        'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',  // Lavender
        'linear-gradient(135deg, #fccb90 0%, #d57eeb 100%)',  // Peach-Purple
        'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)',  // Light Purple-Blue
        'linear-gradient(135deg, #f6d365 0%, #fda085 100%)',  // Yellow-Orange
        'linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%)',  // Cyan-Blue
    ];
    const noTrainerColor = 'linear-gradient(135deg, #a0a0a0 0%, #6c6c6c 100%)'; // Gray for unassigned
    const trainerColorMap = {};
    let colorIndex = 0;
    
    function getTrainerColor(trainerName) {
        if (!trainerName) return noTrainerColor;
        if (!trainerColorMap[trainerName]) {
            trainerColorMap[trainerName] = trainerColors[colorIndex % trainerColors.length];
            colorIndex++;
        }
        return trainerColorMap[trainerName];
    }
    
    // Function to calculate end time (45 minutes later)
    function formatTimeRange(startTime) {
        const [hours, minutes] = startTime.split(':').map(Number);
        const startDate = new Date(2000, 0, 1, hours, minutes);
        const endDate = new Date(startDate.getTime() + 45 * 60000); // Add 45 minutes
        
        const endHours = String(endDate.getHours()).padStart(2, '0');
        const endMinutes = String(endDate.getMinutes()).padStart(2, '0');
        
        return `${startTime} - ${endHours}:${endMinutes}`;
    }
    
    // Load schedule data
    loadSchedule();
    
    function loadSchedule() {
        fetch('/pre-schedule/list')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    scheduleData = data.schedules;
                    renderCalendar();
                }
            })
            .catch(error => console.error('Error loading schedule:', error));
    }
    
    function renderCalendar() {
        const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        
        // Build trainer color map first from all schedule data
        const uniqueTrainers = [...new Set(scheduleData.filter(s => s.trainer_name).map(s => s.trainer_name))];
        uniqueTrainers.forEach(name => getTrainerColor(name));
        
        // Render legend
        const legend = document.getElementById('trainer-legend');
        // Keep the label, clear the rest
        legend.innerHTML = '<span class="text-muted fw-bold me-1"><i class="fas fa-palette me-1"></i>Trainers:</span>';
        uniqueTrainers.forEach(name => {
            const chip = document.createElement('span');
            chip.style.background = getTrainerColor(name);
            chip.style.color = 'white';
            chip.style.padding = '2px 10px';
            chip.style.borderRadius = '12px';
            chip.style.fontSize = '0.75rem';
            chip.style.fontWeight = '600';
            chip.textContent = name;
            legend.appendChild(chip);
        });
        
        // Get all unique time slots and sort them
        const timeSlots = [...new Set(scheduleData.map(s => s.time_slot))].sort();
        
        // If no time slots, show default hours
        const defaultTimes = timeSlots.length > 0 ? timeSlots : [
            '08:00', '09:00', '10:00', '11:00', '12:00', '13:00', 
            '14:00', '15:00', '16:00', '17:00', '18:00', '19:00', '20:00'
        ];
        
        const scheduleBody = document.getElementById('schedule-body');
        scheduleBody.innerHTML = '';
        
        defaultTimes.forEach(time => {
            const row = document.createElement('tr');
            
            // Time cell
            const timeCell = document.createElement('td');
            timeCell.className = 'time-cell';
            timeCell.textContent = time;
            row.appendChild(timeCell);
            
            // Day cells
            days.forEach(day => {
                const dayCell = document.createElement('td');
                
                // Find schedules for this day and time
                const daySchedules = scheduleData.filter(s => 
                    s.day_of_week === day && s.time_slot === time && s.is_active === 1
                );
                
                if (daySchedules.length > 0) {
                    // Group by trainer (trainer_id or 'none')
                    const groups = {};
                    daySchedules.forEach(s => {
                        const key = s.trainer_id || 'none';
                        if (!groups[key]) groups[key] = [];
                        groups[key].push(s);
                    });
                    
                    Object.values(groups).forEach(group => {
                        const first = group[0];
                        const slotDiv = document.createElement('div');
                        slotDiv.className = 'schedule-slot';
                        slotDiv.dataset.scheduleIds = group.map(s => s.id).join(',');
                        slotDiv.style.background = getTrainerColor(first.trainer_name);
                        
                        // Build student names list
                        const studentsHtml = group.map(s => 
                            `<span class="student-name-item" data-id="${s.id}">${s.student_name} <span class="level-badge">${s.student_level}</span></span>`
                        ).join('');
                        
                        slotDiv.innerHTML = `
                            <div class="student-names">${studentsHtml}</div>
                            <div class="time-range"><i class="fas fa-clock me-1"></i>${formatTimeRange(first.time_slot)}</div>
                            ${first.trainer_name ? `<div class="trainer-name"><i class="fas fa-user-tie me-1"></i>${first.trainer_name}</div>` : ''}
                            ${first.notes ? `<div class="notes-text">${first.notes}</div>` : ''}
                        `;
                        
                        <% if (typeof isReadOnly === 'undefined' || !isReadOnly) { %>
                        slotDiv.addEventListener('click', () => openGroupEditModal(group));
                        <% } %>
                        dayCell.appendChild(slotDiv);
                    });
                }
                
                row.appendChild(dayCell);
            });
            
            scheduleBody.appendChild(row);
        });
    }
    
    function openGroupEditModal(group) {
        <% if (typeof isReadOnly !== 'undefined' && isReadOnly) { %>
        alert('View Only: Contact operations manager to make changes to the schedule.');
        return;
        <% } %>
        
        // If single student, use normal edit
        if (group.length === 1) {
            openEditModal(group[0]);
            return;
        }
        
        // For group, let user pick which student to edit
        let msg = 'Which student do you want to edit?\n\n';
        group.forEach((s, i) => {
            msg += `${i + 1}. ${s.student_name} (${s.student_level})\n`;
        });
        msg += `\nEnter number (1-${group.length}):`;
        
        const choice = prompt(msg);
        if (!choice) return;
        
        const idx = parseInt(choice) - 1;
        if (idx >= 0 && idx < group.length) {
            openEditModal(group[idx]);
        } else {
            alert('Invalid selection');
        }
    }
    
    function openEditModal(schedule) {
        <% if (typeof isReadOnly !== 'undefined' && isReadOnly) { %>
        // Read-only mode - show alert instead of edit modal
        alert('View Only: Contact operations manager to make changes to the schedule.');
        return;
        <% } %>
        
        document.getElementById('edit-schedule-id').value = schedule.id;
        document.getElementById('edit-day').value = schedule.day_of_week;
        document.getElementById('edit-student').value = schedule.student_id;
        document.getElementById('edit-time').value = schedule.time_slot;
        document.getElementById('edit-trainer').value = schedule.trainer_id || '';
        document.getElementById('edit-notes').value = schedule.notes || '';
        
        editScheduleModal.show();
    }
    
    // Search filter for student checkboxes
    document.getElementById('add-student-search').addEventListener('input', function() {
        const query = this.value.toLowerCase();
        document.querySelectorAll('.student-check-item').forEach(item => {
            item.style.display = item.dataset.name.includes(query) ? '' : 'none';
        });
    });
    
    // Update selected count
    document.getElementById('add-student-list').addEventListener('change', function() {
        const count = document.querySelectorAll('.add-student-cb:checked').length;
        document.getElementById('add-student-count').textContent = count + ' selected';
    });
    
    // Add schedule
    document.getElementById('save-schedule-btn').addEventListener('click', function() {
        const day = document.getElementById('add-day').value;
        const selectedStudents = [...document.querySelectorAll('.add-student-cb:checked')].map(cb => cb.value);
        const time = document.getElementById('add-time').value;
        const trainer = document.getElementById('add-trainer').value;
        const notes = document.getElementById('add-notes').value;
        
        if (!day || selectedStudents.length === 0 || !time) {
            alert('Please fill in all required fields (Day, at least one Student, Time)');
            return;
        }
        
        // Check for duplicates
        for (const studentId of selectedStudents) {
            if (!checkTimeConflict(day, time, trainer, null, studentId)) {
                return;
            }
        }
        
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Adding...';
        
        // Send one request per student
        const promises = selectedStudents.map(studentId =>
            fetch('/pre-schedule/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    day_of_week: day,
                    student_id: studentId,
                    time_slot: time,
                    trainer_id: trainer || null,
                    notes: notes
                })
            }).then(r => r.json())
        );
        
        Promise.all(promises)
            .then(results => {
                const failed = results.filter(r => !r.success);
                if (failed.length > 0) {
                    alert(`Added ${results.length - failed.length} student(s). ${failed.length} failed.`);
                } else {
                    alert(`${results.length} student(s) added to schedule successfully!`);
                }
                addScheduleModal.hide();
                // Reset form
                document.getElementById('add-day').value = '';
                document.querySelectorAll('.add-student-cb:checked').forEach(cb => cb.checked = false);
                document.getElementById('add-student-count').textContent = '0 selected';
                document.getElementById('add-student-search').value = '';
                document.querySelectorAll('.student-check-item').forEach(item => item.style.display = '');
                document.getElementById('add-time').value = '';
                document.getElementById('add-trainer').value = '';
                document.getElementById('add-notes').value = '';
                loadSchedule();
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error adding to schedule');
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-2"></i>Add to Schedule';
            });
    });
    
    // Function to check for duplicate student in same slot (allows multiple students per slot)
    function checkTimeConflict(day, newTime, trainerId, excludeScheduleId, studentId) {
        // Only prevent the same student from being added to the same day+time
        const duplicate = scheduleData.find(s => 
            s.day_of_week === day && 
            s.time_slot === newTime && 
            s.student_id == studentId &&
            s.is_active === 1 &&
            s.id != excludeScheduleId
        );
        
        if (duplicate) {
            alert(`⚠️ DUPLICATE!\n\n${duplicate.student_name} is already scheduled at ${formatTimeRange(newTime)} on ${day}.\n\nThe same student cannot be added twice to the same slot.`);
            return false;
        }
        
        return true; // No conflict - multiple students per slot is allowed
    }
    
    // Update schedule
    document.getElementById('update-schedule-btn').addEventListener('click', function() {
        const id = document.getElementById('edit-schedule-id').value;
        const day = document.getElementById('edit-day').value;
        const student = document.getElementById('edit-student').value;
        const time = document.getElementById('edit-time').value;
        const trainer = document.getElementById('edit-trainer').value;
        const notes = document.getElementById('edit-notes').value;
        
        if (!day || !student || !time) {
            alert('Please fill in all required fields (Day, Student, Time)');
            return;
        }
        
        // Check for duplicate student in same slot (exclude current schedule)
        if (!checkTimeConflict(day, time, trainer, id, student)) {
            return; // Duplicate detected, don't proceed
        }
        
        fetch('/pre-schedule/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                id: id,
                day_of_week: day,
                student_id: student,
                time_slot: time,
                trainer_id: trainer || null,
                notes: notes
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Schedule updated successfully!');
                editScheduleModal.hide();
                loadSchedule();
            } else {
                alert('Error: ' + data.error);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error updating schedule');
        });
    });
    
    // Delete schedule
    document.getElementById('delete-schedule-btn').addEventListener('click', function() {
        if (!confirm('Are you sure you want to remove this student from the schedule?')) {
            return;
        }
        
        const id = document.getElementById('edit-schedule-id').value;
        
        fetch('/pre-schedule/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Student removed from schedule successfully!');
                editScheduleModal.hide();
                loadSchedule();
            } else {
                alert('Error: ' + data.error);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error deleting schedule');
        });
    });
});
</script>
