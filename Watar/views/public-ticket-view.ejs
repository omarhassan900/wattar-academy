<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Ticket — <%= eventName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #000; color: #fff; min-height: 100vh; font-family: 'Inter', sans-serif; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .ticket-container { max-width: 550px; width: 100%; text-align: center; }
        .ticket-image-wrapper { position: relative; margin-bottom: 1.5rem; }
        .ticket-image-wrapper img { width: 100%; border-radius: 12px; }
        .ticket-name-overlay {
            position: absolute; bottom: 80px; left: 0; right: 0;
            font-size: 1.3rem; font-weight: 700; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.9);
        }
        .ticket-seat-overlay {
            position: absolute; bottom: 40px; left: 0; right: 0;
            font-size: 1.1rem; font-weight: 600; color: #ffd700; text-shadow: 0 2px 8px rgba(0,0,0,0.9);
        }
        .ticket-info { background: #111; border: 1px solid #333; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
        .ticket-info h3 { margin: 0 0 0.5rem; font-weight: 700; }
        .ticket-info p { color: #888; margin: 0.3rem 0; }
        .ticket-id { font-size: 0.8rem; color: #555; margin-top: 1rem; }
        .pending-box { background: #1a1a00; border: 1px solid #665500; border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
        .pending-box i { font-size: 3rem; color: #ffc107; margin-bottom: 1rem; }
        .rejected-box { background: #1a0000; border: 1px solid #660000; border-radius: 12px; padding: 2rem; }
        .rejected-box i { font-size: 3rem; color: #dc3545; margin-bottom: 1rem; }
        /* Seat map styles */
        .seat-map-section { background: #111; border: 1px solid #333; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
        .seat-grid { display: flex; flex-direction: column; align-items: center; gap: 3px; }
        .seat-row { display: flex; align-items: center; gap: 3px; }
        .seat-label { width: 18px; font-weight: 700; font-size: 0.6rem; text-align: center; color: #666; }
        .seat {
            width: 22px; height: 22px; border-radius: 3px; border: none;
            font-size: 0; display: flex; align-items: center; justify-content: center;
        }
        .seat.available { background: #333; }
        .seat.taken { background: #555; }
        .seat.mine { background: #ffd700; }
        .col-labels { display: flex; gap: 3px; margin-left: 21px; margin-bottom: 3px; }
        .col-label { width: 22px; text-align: center; font-size: 0.55rem; font-weight: 600; color: #666; }
        .stage-label { background: #333; color: #fff; padding: 4px 20px; display: inline-block; border-radius: 3px; font-weight: 600; font-size: 0.75rem; margin-bottom: 8px; }
        .legend { display: flex; gap: 12px; justify-content: center; margin-top: 10px; font-size: 0.7rem; color: #888; }
        .legend span { display: flex; align-items: center; gap: 4px; }
        .legend-dot { width: 12px; height: 12px; border-radius: 2px; }
    </style>
</head>
<body>

<div class="ticket-container">

    <% if (ticket.status === 'pending') { %>
        <div class="pending-box">
            <i class="fas fa-clock"></i>
            <h3>Payment Under Review</h3>
            <p style="color:#888;">Your payment is being verified. Once approved, your ticket will appear here.</p>
            <p style="color:#666;margin-top:1rem;font-size:0.85rem;">Reservation by: <strong><%= ticket.buyer_name %></strong></p>
            <p style="color:#666;font-size:0.85rem;">Keep this link — check back soon!</p>
        </div>

    <% } else if (ticket.status === 'rejected') { %>
        <div class="rejected-box">
            <i class="fas fa-times-circle"></i>
            <h3>Payment Not Verified</h3>
            <p style="color:#888;">Unfortunately, your payment could not be verified.</p>
            <% if (ticket.rejection_reason) { %>
                <p style="color:#999;margin-top:0.5rem;"><strong>Reason:</strong> <%= ticket.rejection_reason %></p>
            <% } %>
            <p style="color:#666;margin-top:1rem;font-size:0.85rem;">Please contact us if you believe this is an error.</p>
        </div>

    <% } else { %>
        <div class="ticket-image-wrapper">
            <img src="/images/ticket-template.jpeg" alt="Ticket">
            <div class="ticket-name-overlay"><%= ticket.buyer_name %></div>
            <% if (ticket.seat_number) { %>
                <div class="ticket-seat-overlay">Seat: <%= ticket.seat_number %></div>
            <% } %>
        </div>
        
        <div class="ticket-info">
            <h3><%= eventName %></h3>
            <p><i class="fas fa-calendar me-2"></i><%= eventDate %></p>
            <p><i class="fas fa-user me-2"></i><%= ticket.buyer_name %></p>
            <% if (ticket.seat_number) { %>
                <p><i class="fas fa-chair me-2"></i>Seat: <strong><%= ticket.seat_number %></strong></p>
            <% } %>
        </div>

        <div class="ticket-id">Ticket #<%= ticket.id %> — Verified ✓</div>
    <% } %>

    <!-- Seat Map -->
    <div class="seat-map-section">
        <div class="stage-label">STAGE</div>
        <div class="seat-grid" id="seatMapPublic"></div>
        <div class="legend">
            <span><div class="legend-dot" style="background:#333;"></div> Available</span>
            <span><div class="legend-dot" style="background:#555;"></div> Taken</span>
            <% if (ticket.status === 'approved' && ticket.seat_number) { %>
            <span><div class="legend-dot" style="background:#ffd700;"></div> Your Seat</span>
            <% } %>
        </div>
    </div>

</div>

<script>
const rows = ['A','B','C','D','E','F','G','H','I','J','K','L'];
const cols = 12;
const takenSeats = <%- JSON.stringify(takenSeats) %>;
const mySeat = '<%= ticket.seat_number || "" %>';
const mySeats = mySeat.split(',').map(s => s.trim()).filter(s => s);

function buildMap() {
    const container = document.getElementById('seatMapPublic');
    let html = '';
    
    // Column labels
    html += '<div class="col-labels">';
    for (let c = 1; c <= cols; c++) {
        html += `<div class="col-label">${c}</div>`;
        if (c === 6) html += '<div class="col-label"></div>';
    }
    html += '</div>';
    
    for (let r = 0; r < rows.length; r++) {
        html += '<div class="seat-row">';
        html += `<div class="seat-label">${rows[r]}</div>`;
        for (let c = 1; c <= cols; c++) {
            const seatId = rows[r] + c;
            let cls = 'seat ';
            if (mySeats.includes(seatId)) cls += 'mine';
            else if (takenSeats[seatId]) cls += 'taken';
            else cls += 'available';
            html += `<div class="${cls}" title="${seatId}"></div>`;
            if (c === 6) html += '<div style="width:16px;"></div>';
        }
        html += '</div>';
    }
    container.innerHTML = html;
}

buildMap();
</script>
</body>
</html>
