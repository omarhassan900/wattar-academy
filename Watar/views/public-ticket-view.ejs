<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Ticket — <%= eventName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #000; color: #fff; min-height: 100vh; font-family: 'Inter', sans-serif; display: flex; align-items: center; justify-content: center; }
        .ticket-container { max-width: 500px; width: 100%; padding: 20px; text-align: center; }
        .ticket-image-wrapper { position: relative; margin-bottom: 1.5rem; }
        .ticket-image-wrapper img { width: 100%; border-radius: 12px; }
        .ticket-name-overlay {
            position: absolute;
            bottom: 80px;
            left: 0;
            right: 0;
            font-size: 1.3rem;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 2px 8px rgba(0,0,0,0.9);
        }
        .ticket-seat-overlay {
            position: absolute;
            bottom: 40px;
            left: 0;
            right: 0;
            font-size: 1.1rem;
            font-weight: 600;
            color: #ffd700;
            text-shadow: 0 2px 8px rgba(0,0,0,0.9);
        }
        .ticket-info { background: #111; border: 1px solid #333; border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem; }
        .ticket-info h3 { margin: 0 0 0.5rem; font-weight: 700; }
        .ticket-info p { color: #888; margin: 0.3rem 0; }
        .ticket-id { font-size: 0.8rem; color: #555; margin-top: 1rem; }
        .pending-box { background: #1a1a00; border: 1px solid #665500; border-radius: 12px; padding: 2rem; }
        .pending-box i { font-size: 3rem; color: #ffc107; margin-bottom: 1rem; }
        .rejected-box { background: #1a0000; border: 1px solid #660000; border-radius: 12px; padding: 2rem; }
        .rejected-box i { font-size: 3rem; color: #dc3545; margin-bottom: 1rem; }
    </style>
</head>
<body>

<div class="ticket-container">

    <% if (ticket.status === 'pending') { %>
        <!-- Pending State -->
        <div class="pending-box">
            <i class="fas fa-clock"></i>
            <h3>Payment Under Review</h3>
            <p style="color:#888;">Your payment is being verified. Once approved, your ticket will appear here.</p>
            <p style="color:#666;margin-top:1rem;font-size:0.85rem;">Reservation by: <strong><%= ticket.buyer_name %></strong></p>
            <p style="color:#666;font-size:0.85rem;">Keep this link — check back soon!</p>
        </div>

    <% } else if (ticket.status === 'rejected') { %>
        <!-- Rejected State -->
        <div class="rejected-box">
            <i class="fas fa-times-circle"></i>
            <h3>Payment Not Verified</h3>
            <p style="color:#888;">Unfortunately, your payment could not be verified.</p>
            <% if (ticket.rejection_reason) { %>
                <p style="color:#999;margin-top:0.5rem;"><strong>Reason:</strong> <%= ticket.rejection_reason %></p>
            <% } %>
            <p style="color:#666;margin-top:1rem;font-size:0.85rem;">Please contact us if you believe this is an error.</p>
        </div>

    <% } else { %>
        <!-- Approved State - Show Ticket -->
        <div class="ticket-image-wrapper">
            <img src="/images/ticket-template.jpeg" alt="Ticket">
            <div class="ticket-name-overlay"><%= ticket.buyer_name %></div>
            <% if (ticket.seat_number) { %>
                <div class="ticket-seat-overlay">Seat: <%= ticket.seat_number %></div>
            <% } %>
        </div>
        
        <div class="ticket-info">
            <h3><%= eventName %></h3>
            <p><i class="fas fa-calendar me-2"></i><%= eventDate %></p>
            <p><i class="fas fa-user me-2"></i><%= ticket.buyer_name %></p>
            <% if (ticket.seat_number) { %>
                <p><i class="fas fa-chair me-2"></i>Seat: <strong><%= ticket.seat_number %></strong></p>
            <% } %>
        </div>

        <div class="ticket-id">Ticket #<%= ticket.id %> — Verified ✓</div>
    <% } %>

</div>

</body>
</html>
