<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= eventName %> — Reserve Your Ticket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #000; color: #fff; min-height: 100vh; font-family: 'Inter', sans-serif; }
        .ticket-card { background: #111; border: 1px solid #333; border-radius: 16px; max-width: 500px; margin: 40px auto; }
        .ticket-header { background: #fff; color: #000; padding: 2rem; border-radius: 16px 16px 0 0; text-align: center; }
        .ticket-header h1 { font-weight: 800; font-size: 1.8rem; margin: 0; }
        .ticket-body { padding: 2rem; }
        .event-info { display: flex; justify-content: space-between; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #333; }
        .event-info div { text-align: center; }
        .event-info .label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 0.1em; }
        .event-info .value { font-size: 1.1rem; font-weight: 700; margin-top: 4px; }
        .form-control { background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 8px; padding: 12px 16px; }
        .form-control:focus { background: #1a1a1a; border-color: #fff; color: #fff; box-shadow: none; }
        .form-control::placeholder { color: #666; }
        .form-label { font-size: 0.85rem; font-weight: 600; color: #ccc; }
        .btn-reserve { background: #fff; color: #000; border: none; font-weight: 700; padding: 14px; border-radius: 8px; width: 100%; font-size: 1rem; }
        .btn-reserve:hover { background: #eee; color: #000; }
        .btn-reserve:disabled { background: #333; color: #666; }
        .instapay-box { background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 16px; text-align: center; margin-bottom: 1.5rem; }
        .instapay-number { font-size: 1.4rem; font-weight: 700; letter-spacing: 0.05em; color: #fff; }
        .sold-out { background: #dc3545; color: #fff; padding: 1rem; border-radius: 8px; text-align: center; font-weight: 700; }
        .success-msg { text-align: center; padding: 2rem; }
        .success-msg i { font-size: 4rem; color: #28a745; margin-bottom: 1rem; }
        .available-badge { background: #28a745; color: #fff; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }
        .logo { width: 50px; height: 50px; margin-bottom: 12px; }
    </style>
</head>
<body>

<div class="ticket-card">
    <div class="ticket-header">
        <img src="/images/logo.jpg" alt="Watar" class="logo" style="border-radius:8px;">
        <h1><%= eventName %></h1>
    </div>
    <div class="ticket-body">
        <div class="event-info">
            <div>
                <div class="label">Date</div>
                <div class="value"><%= eventDate %></div>
            </div>
            <div>
                <div class="label">Price</div>
                <div class="value"><%= ticketPrice %> EGP</div>
            </div>
            <div>
                <div class="label">Available</div>
                <div class="value"><span class="available-badge"><%= available %></span></div>
            </div>
        </div>

        <% if (soldOut) { %>
            <div class="sold-out"><i class="fas fa-ticket-alt me-2"></i>SOLD OUT</div>
        <% } else { %>

        <div id="reserveForm">
            <div class="instapay-box">
                <div class="label mb-1">Send <%= ticketPrice %> EGP via InstaPay to</div>
                <div class="instapay-number"><%= instapayNumber %></div>
                <small style="color:#888;">Then upload the screenshot below</small>
            </div>

            <div class="mb-3">
                <label class="form-label">Full Name *</label>
                <input type="text" class="form-control" id="buyer_name" placeholder="Your full name" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Phone Number *</label>
                <input type="tel" class="form-control" id="buyer_phone" placeholder="01xxxxxxxxx" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Email (optional)</label>
                <input type="email" class="form-control" id="buyer_email" placeholder="your@email.com">
            </div>
            <div class="mb-3">
                <label class="form-label">Payment Screenshot *</label>
                <input type="file" class="form-control" id="payment_screenshot" accept="image/*" required>
            </div>

            <button class="btn btn-reserve" id="submitBtn" onclick="submitReservation()">
                <i class="fas fa-ticket-alt me-2"></i>Reserve My Ticket
            </button>
        </div>

        <div id="successMsg" class="success-msg" style="display:none;">
            <i class="fas fa-check-circle"></i>
            <h3>Reservation Submitted!</h3>
            <p style="color:#888;">Your payment is being verified. Check your ticket status at the link below:</p>
            <a id="ticketLink" href="#" target="_blank" style="color:#fff;text-decoration:underline;font-weight:600;word-break:break-all;"></a>
            <p style="color:#555;margin-top:1rem;font-size:0.85rem;">Save this link! Your ticket will appear there once approved.</p>
        </div>

        <% } %>
    </div>
</div>

<script>
function submitReservation() {
    const name = document.getElementById('buyer_name').value.trim();
    const phone = document.getElementById('buyer_phone').value.trim();
    const email = document.getElementById('buyer_email').value.trim();
    const file = document.getElementById('payment_screenshot').files[0];

    if (!name || !phone) return alert('Please fill in your name and phone number');
    if (!file) return alert('Please upload your payment screenshot');

    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';

    const formData = new FormData();
    formData.append('buyer_name', name);
    formData.append('buyer_phone', phone);
    formData.append('buyer_email', email);
    formData.append('payment_screenshot', file);

    fetch('/concert/reserve', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                document.getElementById('reserveForm').style.display = 'none';
                document.getElementById('successMsg').style.display = '';
                if (d.token) {
                    const link = window.location.origin + '/concert/ticket/' + d.token;
                    const linkEl = document.getElementById('ticketLink');
                    linkEl.href = link;
                    linkEl.textContent = link;
                }
            } else {
                alert(d.error || 'Something went wrong');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-ticket-alt me-2"></i>Reserve My Ticket';
            }
        })
        .catch(() => {
            alert('Connection error. Please try again.');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-ticket-alt me-2"></i>Reserve My Ticket';
        });
}
</script>
</body>
</html>
